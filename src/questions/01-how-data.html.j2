{#- data -#}
{%- set measured = x.creatingData.hasMeasuredData -%}
{%- set preexisting = x.reusingData.hasPreExistingData -%}
{%- set metadata = x.creatingData.collectingMetadata -%}

<div id="q-how-data" class="question">
  <h3>{% trans %}1. How will new data be collected or produced and/or how will existing data be re-used?{% endtrans %}</h3>

  <div class="answer">


  {%- if measured._value is true -%}
    {# Measured datasets #}
    {%- set datasets = measured.datasets -%}
    {%- if datasets|length > 0 -%}
      <h4>{% trans %}Instrument datasets{% endtrans %}</h4>
      <ul class="entries">
        {%- for dataset in datasets -%}
          <li>
            {%- set datasetName = dataset.dataset._value -%}
            <strong>{{ datasetName if datasetName else _("(no name given)") }}</strong>
            {# Instruments #}
            {%- if dataset.instruments|length > 0 -%}
              <p>{% trans %}For this dataset, we are using the following instruments:{% endtrans %}
              <ul>
                {%- for instrument in dataset.instruments -%}
                  <li>
                    {%- set instrumentName = instrument.name._value -%}
                    {%- set instrumentDesc = instrument.description._value -%}
                    <strong>{{ instrumentName if instrumentName }}</strong>
                    {% if instrumentName and instrumentDesc -%}<span class="separator">&ndash;</span>{%- endif %}
                    {{ macros.md(instrumentDesc) if instrumentDesc }}
                  </li>
                {%- endfor -%}
              </ul>
              </p>
            {%- else -%}
              <p>{% trans %}No instruments for this dataset have been specified.{% endtrans %}</p>
            {%- endif -%}
            {# Quality #}
            {%- set quality = dataset.hasQualityProcesses -%}
            {%- if quality._value is false -%}
              <p>{% trans %}We will not be using a quality process for this dataset.{% endtrans %}</p>
            {%- elif quality._value is true -%}
              {# Named quality processes #}
              {%- set calibrating = quality.calibration._value is true -%}
              {%- set repetition = quality.repeat._value is true -%}
              {%- set standardized = quality.standardised._value is true -%}
              {%- set validation = quality.validation._value is true -%}
              {%- set peerReview = quality.peerReview._value is true -%}
              {%- set vocabularies = quality.vocabularies._value is true -%}
              {%- set consistency = quality.consistency._value is true -%}
              {%- set qualityProcesses = [consistency, calibrating, repetition, standardized, validation, peerReview, vocabularies] -%}
              {%- set qualityCount = qualityProcesses|select("true")|list|length -%}
              {%- if qualityCount == 1 -%}
                <p>
                  {% trans %}We will be using{% endtrans %}
                  {% if calibrating -%}
                    {% trans %}calibrating measurements{% endtrans %}
                  {%- endif -%}
                  {%- if repetition -%}
                    {% trans %}repeat samples/measurements{% endtrans %}
                  {%- endif -%}
                  {%- if standardized -%}
                    {% trans %}standardized data capture/recording{% endtrans %}
                  {%- endif -%}
                  {%- if validation -%}
                    {% trans %}<em>Data Entry</em> validation{% endtrans %}
                  {%- endif -%}
                  {%- if peerReview -%}
                    {% trans %}data peer review{% endtrans %}
                  {%- endif -%}
                  {%- if vocabularies -%}
                    {% trans %}controlled vocabularies{% endtrans %}
                  {%- endif %}
                  {%- if consistency -%}
                    {% trans %}measuring samples for which the outcome is known in order to monitor consistency{% endtrans %}
                  {%- endif %}
                  {% trans %}as part of the quality process.{% endtrans %}
                </p>
              {%- elif qualityCount > 1 -%}
                <p>
                {% trans %}We will be using the following quality processes:{% endtrans %}
                <ul>
                  {%- if calibrating -%}
                    <li>{% trans %}calibrating measurements{% endtrans %}</li>
                  {%- endif -%}
                  {%- if repetition -%}
                    <li>{% trans %}repeat samples/measurements{% endtrans %}</li>
                  {%- endif -%}
                  {%- if standardized -%}
                    <li>{% trans %}standardized data capture/recording{% endtrans %}</li>
                  {%- endif -%}
                  {%- if validation -%}
                    <li>{% trans %}<em>Data Entry</em> validation{% endtrans %}</li>
                  {%- endif -%}
                  {%- if peerReview -%}
                    <li>{% trans %}data peer review{% endtrans %}</li>
                  {%- endif -%}
                  {%- if vocabularies -%}
                    <li>{% trans %}controlled vocabularies{% endtrans %}</li>
                  {%- endif -%}
                  {%- if consistency -%}
                    <li>{% trans %}measuring samples with known outcome (to monitor consistency){% endtrans %}</li>
                  {%- endif %}
                </ul>
                </p>
              {%- else -%}
                <p>{% trans %}We will be using quality processes.{% endtrans %}<p>
              {%- endif -%}
              {# Other quality processes #}
              {%- if quality.other._value is true -%}
                {%- set qualityOther = quality.other.other._value -%}
                {%- if qualityOther -%}
                  <p>{% if qualityCount > 0 %}{% trans value=(macros.md(qualityOther)) %}Additional quality processes are: {{ value }}{% endtrans %}{% else %}{% trans value=(macros.md(qualityOther)) %}Our quality processes are: {{ value }}{% endtrans %}{% endif %}</p>
                {%- endif -%}
              {%- endif -%}
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  {%- else -%}
    <p>{% trans %}There will be no instrument dataset in this project.{% endtrans %}</p>
  {%- endif -%}

 {# Existing datasets #}
  {%- if preexisting._value is true -%}
    {%- set refDatasets = preexisting.referenceDatasets -%}
    {%- set nrefDatasets = preexisting.nonReferenceDatasets -%}

    {%- if (refDatasets|length > 0) or (nrefDatasets|length > 0) -%}
      <div>
      <h4>{% trans %}Re-used datasets{% endtrans %}</h4>
      <ul class="entries">
      {# Reference Data #}
        {%- for refData in refDatasets -%}
          <li>
          {%- set refDataUse = refData.using -%}
          {%- set refDataName = refData.dataset._value -%}

          {%- set refDataWhere = refData.pid._value -%}

          {%- if refDataName -%}
            <strong>{{ refDataName }}</strong>
          {%- else -%}
            <strong>{% trans %}(no name given){% endtrans %}</strong>
          {%- endif -%}

          {# Reference data set will be used #}
          {%- if refDataUse._value is true  %}

            {# identification #}
            <p>{% trans %}We will re-use this standard reference data{% endtrans %}
            {%- if refDataWhere -%}
              {{ " " }}{% trans %}available via:{% endtrans %}{{ " " }}
              {%- if refDataWhere.startswith("http://") or refDataWhere.startswith("https://") or refDataWhere.startswith("ftp://") -%}
                <a href="{{ refDataWhere }}" target="_blank">{{ refDataWhere }}</a>
              {%- else -%}
                {{ refDataWhere }}
             {%- endif -%}
            {%- endif -%}

            {# usage #}
            {%- set refDataUsage = refDataUse.usage._value -%}
            {%- if refDataUsage -%}
                {{+" "}}{% trans value=(macros.md(refDataUsage|trim|dot)) %}in order to {{ value }}{% endtrans %}
            {%- else -%}.
            {%- endif -%}
            </p>

            {# version #}
            {%- set refDataVersioned = refDataUse.isVersioned -%}
            {%- if refDataVersioned._value is true -%}
              {%- set refDataVersion = refDataVersioned.version._value -%}
              {%- set refDataVersionUpdate = refDataVersioned.updateVersion._value -%}
              {%- if refDataVersion or refDataVersionUpdate is not none  %}
                <p>
                {% if refDataVersion -%}
                  {% trans value=(macros.md(refDataVersion|trim|dot)) %}We will use the following version of this dataset: {{ value }}{% endtrans %}
                {%- endif -%}
                {%- if refDataVersionUpdate == 'stayOld' %}
                  {% trans %}If a new version becomes available during the project, we will stay with the old version.{% endtrans %}
                {%- elif refDataVersionUpdate == 'newAnalyses' %}
                  {% trans %}If a new version becomes available during the project, new analyses will be done with the new version.{% endtrans %}
                {%- elif refDataVersionUpdate == 'allAnalyses' %}
                  {% trans %}If a new version becomes available during the project, all analyses will be redone with the new version.{% endtrans %}
                {%- endif -%}
                </p>
              {%- endif -%}
            {%- endif -%}

            {# availability of the standard reference data for future results reproduction #}
            {%- set refDataReproduce = refDataUse.reproduce._value -%}
            <p>
            {%- if refDataReproduce == 'keepsOldVersions' -%}
              {% trans %}This standard reference data will be available for long-term by the provider.{% endtrans %}
            {%- elif refDataReproduce == 'keepCopy'  -%}
              {% trans %}We will keep the copy of this standard reference data and make it available with our results.{% endtrans %}
            {%- elif refDataReproduce == 'both' -%}
              {% trans %}This standard reference data will be available for long-term by the provider as well as we will keep the copy of this dataset and make it available with our results.{% endtrans %}
            {%- endif -%}
            </p>

            {# licence #}
            {%- set refDataConditions = refDataUse.conditions._value -%}
            {%- set refDataConditionsOther = refDataUse.conditions.conditions._value -%}
            {%- if refDataConditions is not none %}
             <p>{% trans %}This standard reference data are{% endtrans %}{{+" "}}
              {%- if refDataConditions == 'cc0' -%}
                {% trans %}freely available for any use.{% endtrans %}
              {%- elif refDataConditions == 'cc-by' -%}
                {% trans %}freely available with obligation to quote the source.{% endtrans %}
              {%- elif refDataConditions == 'restrictions' -%}
                {% trans %}available with{% endtrans %}{{ " " }}
                  {%- if refDataConditionsOther -%}
                    {% trans value=(macros.md(refDataConditionsOther)) %}following restrictions: {{ value }}{% endtrans %}
                  {%- else -%}
                    {{ " " }}{% trans %}restrictions, that will be specified.{% endtrans %}
                  {%- endif -%}
              {%- endif -%}
             </p>
            {%- endif -%}

            {# format #}
            {%- set refDataFormat = refDataUse.format._value -%}
            <p>
            {%- if refDataFormat == 'convert' -%}
              {% trans %}The standard reference data are in the format that has to be transformed before using.{% endtrans %}
            {%- elif refDataFormat == 'ok' -%}
              {% trans %}The standard reference data are in the format that does not have to be transformed and we can use it directly.{% endtrans %}
            {% endif %}
            </p>

          {# Reference data set that will NOT be used #}
          {%- elif refDataUse._value is false -%}
            {%- set refDataWhyNot = refDataUse.whyNot._value -%}
            {%- set refDataWhyNotReason = refDataUse.whyNot.reason._value %}

            {# identification #}
            <p> {% trans %}We considered reusing this standard reference data{% endtrans %}
            {%- if refDataWhere -%}
            {{ " " }}{% trans %}available via:{% endtrans %}{{ " " }}
              {%- if refDataWhere.startswith("http://") or refDataWhere.startswith("https://") or refDataWhere.startswith("ftp://") -%}
                <a href="{{ refDataWhere }}" target="_blank">{{ refDataWhere }}</a>
              {%- else -%}
                {{ refDataWhere}}
              {%- endif -%}
            {%- endif -%}

            {# no usage reason #}
            {%- if refDataWhyNot is not none -%}
              {% trans %}, but decided not to re-use it{% endtrans %}
              {%- if refDataWhyNot == 'missesData' -%}
                {{ " " }}{% trans %}because it misses data we need.{% endtrans %}
              {%- elif refDataWhyNot == 'missesAspects' -%}
                {{ " " }}{% trans %}because it misses required aspects.{% endtrans %}
              {%- elif refDataWhyNot == 'insufficientQuality' -%}
                {{ " " }}{% trans %}because it is not sufficient quality.{% endtrans %}
              {%- elif refDataWhyNot == 'conditions' -%}
                {{ " " }}{% trans %}because its conditions of use do not allow us to use it.{% endtrans %}
              {%- elif refDataWhyNot == 'other' and refDataWhyNotReason -%}
                {{ " " }}{% trans value=(macros.md(refDataWhyNotReason)) %}because: {{ value }}{% endtrans %}
              {%- else -%}.
              {%- endif -%}
            {%- else -%}
            . </p>
            {%- endif -%}

          {%- endif -%}
        </li>
      {%- endfor -%}
      </ul>

      {# Non-reference Data #}
      <ul class="entries">
      {%- for nrefData in nrefDatasets -%}
      <li>
        {%- set nrefDataUse = nrefData.using -%}
        {%- set nrefDataName = nrefData.dataset._value -%}
        {%- set nrefDataWhere = nrefData.pid._value -%}

        {%- if nrefDataName -%}
          <strong>{{ nrefDataName }}</strong>
        {%- else -%}
          <strong>{% trans %}(no name given){% endtrans %}</strong>
        {%- endif -%}

        {# Non-reference data set will be used #}
        {%- if nrefDataUse._value is true %}

          {# identification #}
          <p>{% trans %}We will re-use this non-reference data{% endtrans %}
          {%- if nrefDataWhere -%}
         {{ " " }}{% trans %}available via:{% endtrans %}{{ " " }}
            {%- if nrefDataWhere.startswith("http://") or nrefDataWhere.startswith("https://") or nrefDataWhere.startswith("ftp://") -%}
              <a href="{{ nrefDataWhere }}" target="_blank">{{ nrefDataWhere }}</a>
            {%- else -%}
              {{ nrefDataWhere }}
            {%- endif -%}
          {%- endif -%}

          {# usage #}
          {%- set nrefDataUsage = nrefDataUse.usage._value -%}
          {%- if nrefDataUsage -%}
            {{+" "}}{% trans value=(macros.md(nrefDataUsage|trim|dot)) %}in order to {{ value }}{% endtrans %}
          {%- else -%}.
          {%- endif -%}
          </p>

          {# Which part of the non-reference data we will use #}
          {%- set nrefDataComplete = nrefDataUse.useComplete._value -%}
          {%- if nrefDataComplete is not none -%}
            <p>{% trans %}We will use{% endtrans %}{{+" "}}
            {%- if nrefDataComplete == 'complete' -%}
              {% trans %}the complete data set.{% endtrans %}
            {%- elif nrefDataComplete == 'selection' -%}
              {% trans %}only subset of data and we will select it by filtering and/or selection (which will be documented).{% endtrans %}
            {%- elif nrefDataComplete == 'availableSubset' -%}
              {% trans %}only selected subset of data, which will be available together with our results.{% endtrans %}
            {%- endif -%}
            </p>
          {%- endif -%}

          {# Format #}
          {%- if nrefDataUse.format._value == 'convert' %}
            <p>{% trans %}The format of this data needs to be transformed before we can use it.{% endtrans %}</p>
          {%- endif -%}

          {# Versioning - will change in the future? #}
          {%- set nrefDataFixed = nrefDataUse.fixedOrUpdated._value -%}
          {%- if nrefDataFixed is not none %}
            <p>{% trans %}This data{% endtrans %}{{+" "}}
            {%- if nrefDataFixed == 'fixed' -%}
              {% trans %}are fixed, therefore will not influence reproducibility of our results.{% endtrans %}
            {%- elif nrefDataFixed == 'mayChange' -%}
              {% trans %}may change in the future, which might influence reproducibility of our results.{% endtrans %}
            {%- endif -%}
            </p>
          {%- endif -%}

          {# Licence #}
          {%- set nrefDataConditions = nrefDataUse.conditions._value -%}
          {%- if nrefDataConditions is not none %}
            <p>{% trans %}This data are{% endtrans %}{{+" "}}
            {%- if nrefDataConditions == 'cc0' -%}
              {% trans %}freely available for any use.{% endtrans %}
            {%- elif nrefDataConditions == 'cc-by' -%}
              {% trans %}freely available with obligation to quote the source.{% endtrans %}
            {%- elif nrefDataConditions == 'restrictions'  -%}
              {%- set nrefDataConditionsOther = nrefDataUse.conditions.conditions._value -%}
              {%- if nrefDataConditionsOther -%}
                {% trans %}available with{% endtrans %}{{ " " }}
                  {%- if nrefDataConditionsOther -%}
                   {% trans value=(macros.md(nrefDataConditionsOther)) %}following restrictions: {{ value }}{% endtrans %}
                  {%- else -%}
                    {{ " " }}{% trans %}restrictions, that will be specified.{% endtrans %}
                  {%- endif -%}
              {%- endif -%}
            {%- endif -%}
            </p>
          {%- endif -%}

          {# Personal Data #}
          {%- set nrefDataPersonal = nrefDataUse.includesPersonalData -%}
          {%- if nrefDataPersonal._value is true %}
          <p>
            {% trans %}This data include personal data{% endtrans %}
            {%- set legalBasis = nrefDataPersonal.legalBasis -%}
            {%- if legalBasis._value is not none -%}
              {% trans %}, legally based on{% endtrans %}{{+" "}}
              {%- if legalBasis._value == 'publicInterest' -%}
                {% trans %}public interest for processing the data under GDPR.{% endtrans %}
              {%- elif legalBasis._value == 'consent' -%}
                {% trans %}consent given by the research subject for processing the data under GDPR{% endtrans %}
                {%- if legalBasis.isCovered._value is not none -%}
                  {% trans %}, which{% endtrans %}{{+" "}}
                  {%- if legalBasis.isCovered._value is true -%}
                    {% trans %}also covers our reuse.{% endtrans %}
                  {%- elif legalBasis.isCovered._value is false -%}
                    {% trans %}does not cover our reuse; therefore, new consent will be needed.{% endtrans %}
                  {%- endif -%}
                {%- else -%}
                .
                {%- endif -%}
              {%- elif legalBasis._value == 'other' -%}
                {%- set legalBasisOther = legalBasis.other._value -%}
                {%- if legalBasisOther == 'legalRequirement' -%}
                  {% trans %}a legal requirement (meaning a legal obligation to do this data processing).{% endtrans %}
                {%- elif legalBasisOther == 'vitalInterest' -%}
                  {% trans %}a vital interest (meaning it needs to be done to protect the vital interests of the data subject).{% endtrans %}
                {%- elif legalBasisOther == 'legitimateInterest' -%}
                  {% trans %}a legitimate interest (meaning data subjects all expect us to do this data processing because of who we are).{% endtrans %}
                {%- elif legalBasisOther == 'contract' -%}
                  {% trans %}a requirement to fulfill our contract with the data subjects.{% endtrans %}
                {%- endif -%}
              {%- endif -%}
            {%- endif -%}
          </p>
          {%- endif -%}

          {# Ethical Approval for Reuse #}
          {%- set nrefDataEthicalApproval = nrefDataUse.needsEthicalApproval._value -%}
          {%- if nrefDataEthicalApproval == 'covered' -%}
            <p>{% trans %}The existing ethical approval under research ethics laws of this non-reference data covers our reuse.{% endtrans %}</p>
          {%- elif nrefDataEthicalApproval == 'extension' -%}
            <p>{% trans %}An extension of existing ethical approval under research ethics laws of this non-reference data will be needed.{% endtrans %}</p>
          {%- elif nrefDataEthicalApproval == 'new' -%}
            <p>{% trans %}New ethical approval under research ethics laws of this non-reference data will be needed to cover our usage of the data.{% endtrans %}</p>
          {%- endif -%}

        {# Non-reference data set that will NOT be used #}
        {%- elif nrefDataUse._value is false -%}
          {%- set nrefDataWhyNot = nrefDataUse.whyNot._value -%}
          {%- set nrefDataWhyNotReason = nrefDataUse.whyNot.reason._value %}

          {# identification #}
          <p>{% trans %}We considered reusing this non-reference data{% endtrans %}
          {%- if nrefDataWhere -%}
          {{+" "}}{% trans %}available via:{% endtrans %}{{ " " }}
            {%- if nrefDataWhere.startswith("http://") or nrefDataWhere.startswith("https://") or nrefDataWhere.startswith("ftp://") -%}
              <a href="{{ nrefDataWhere }}" target="_blank">{{ nrefDataWhere }}</a>
            {%- else -%}
              {{ nrefDataWhere }}
            {%- endif -%}
          {%- endif -%}

          {# no usage reason #}
          {%- if nrefDataWhyNot is not none -%}
            {% trans %}, but decided not to reuse it{% endtrans %}
            {%- if nrefDataWhyNot == 'missesData' -%}
              {{ " " }}{% trans %}because it misses data we need{% endtrans %}
            {%- elif nrefDataWhyNot == 'missesAspects' -%}
              {{ " " }}{% trans %}because it misses required aspects{% endtrans %}
            {%- elif nrefDataWhyNot == 'insufficientQuality' -%}
              {{ " " }}{% trans %}because it is not sufficient quality{% endtrans %}
            {%- elif nrefDataWhyNot == 'conditions' -%}
              {{ " " }}{% trans %}because its conditions of use do not allow us to use it{% endtrans %}
            {%- elif nrefDataWhyNot == 'other' and nrefDataWhyNotReason -%}
              {{ " " }}{% trans value=(macros.md(nrefDataWhyNotReason)) %}because: {{ value }}{% endtrans %}
            {%- else -%}
             .
            {%- endif -%}

          {%- else -%}
          .</p>
          {%- endif -%}

        {%- endif -%}

      </p>
      </li>
      {%- endfor -%}
      </ul>
      </div>
    {%- else -%}
      <p>{% trans %}There are no re-used datasets.{% endtrans %}</p>
    {%- endif -%}

    {# Constrains - Data Harmonization #}
    {%- set harmonisation = preexisting.needHarmonisation -%}
    {%- if harmonisation._value is true -%}
      <p>{% trans %}We need to harmonize different sources of existing data before reusing them{% endtrans %}
      {%- if harmonisation.available._value is true -%}
        {{+" "}}{% trans %}and we will make the results of this harmonization available to others{% endtrans %}
      {%- elif harmonisation.available._value is false -%}
        {{+" "}}{% trans %}but we won't make the results of this harmonization available to others{% endtrans %}
      {%- endif -%}
      .</p>
    {%- endif -%}

    {# Constrains - (Re)made data computer readable #}
    {%- set computerReadable = preexisting.needRemadeForComputer -%}
    {%- if computerReadable._value is true -%}
      <p>{% trans %}We will need to (re-)make the data computer-readable before using them{% endtrans %}

      {%- set crAvailable = computerReadable.available._value -%}
      {%- set crMetadata = computerReadable.provideMetadata -%}

      {%- if crAvailable is not none -%}
        {%- if crAvailable == 'repository' -%}
          {{+" "}}{% trans %}and we will make this computer readable form available to others through a standard repository{% endtrans %}
        {%- elif crAvailable == 'other' -%}
          {{+" "}}{% trans %}and we will make this computer readable form available to others{% endtrans %}
        {%- elif crAvailable == 'no' -%}
          {{+" "}}{% trans %}but we won't make this computer readable form available to others{% endtrans %}
        {%- endif -%}
      {%- endif -%}
      .

      {%- if crMetadata._value is not none -%}
        {%- if crMetadata._value is true %}
            {% trans %}We will provide machine readable, standardized metadata to others{% endtrans %}
            {%- if crMetadata.standards|length  > 0 -%}
              {{+" "}}{% trans %}and we will use the following metadata standards:{% endtrans %}{{+" "}}
                {%- for standard in crMetadata.standards -%}
                  {{ macros.fairsharing(standard.standard) }}{{ ", " if not loop.last else "." }}
                {%- endfor -%}
            {%- else -%}
            .
            {%- endif -%}

        {%- endif -%}

      {%- endif -%}
      </p>
    {%- endif -%}


  {%- endif -%}

  {# Provenance (lab notebooks)#}
    {%- if metadata._value == 'explore' -%}
      {%- set provenance = metadata.howProvenance -%}
      {%- if provenance._value is not none %}
      <h4>{% trans %}Provenance{% endtrans %}</h4>
      {%- if provenance._value == 'labNotebooks' -%}
        <p>{% trans %}We will use lab notebooks to make sure that there is good provenance of the data analysis.{% endtrans %}</p>
      {%- elif provenance._value == 'eln' -%}
        <p>{% trans %}We will use an electronic lab notebook to make sure that there is good provenance of the data analysis.{% endtrans %}</p>
      {%- elif provenance._value == 'workflow' -%}
        <p>{% trans %}Our computing workflow system keeps provenance information about the data analysis.{% endtrans %}</p>
      {%- elif provenance._value == 'other' -%}
        {%- set provenanceOther = provenance.other._value -%}
        {#- TRANSLATORS: %(details)s is ": " followed by the user's text, or just "." -#}
        <p>{% trans details=(": " ~ macros.md(provenanceOther) if provenanceOther else ".") %}We will use a solution other than (electronic) lab notebooks to make sure that there is good provenance of the data analysis{{ details }}{% endtrans %}
      {%- endif -%}
      {%- endif -%}
    {%- endif -%}
  </div>
</div>
