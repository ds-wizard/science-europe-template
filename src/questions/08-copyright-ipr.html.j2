{#- data -#}
{%- set access = x.givingAccessToData -%}
{%- set allOpen = access.allOpenOverTime -%}
{%- set authorisation = allOpen.legalReasons.authenticatedAccess.authorisation -%}
{%- set embargo = access.useEmbargo -%}
{%- set ownership = x.creatingData.collectedDataRights -%}
{%- set preexisting = x.reusingData.hasPreExistingData -%}

<div id="q-copyright-ipr" class="question">
  <h3>{% trans %}8. How will other legal issues, such as intellectual property rights and ownership, be managed? What legislation is applicable?{% endtrans %}</h3>

  <div class="answer">
    {# Open philosophy #}
    {%- if access.asOpenAsPossible._value is true -%}
      <p>{% trans %}We will be working with the philosophy <em>as open as possible</em> for our data.{% endtrans %}</p>
    {%- endif -%}

    {# Can open data #}
    {%- if allOpen._value is true -%}
      <p>{% trans %}All of our data can become completely open over time.{% endtrans %}</p>
    {%- elif allOpen._value is false -%}
      {%- set notOpenBusinessReasonsOther = allOpen.businessReasons.other._value -%}
      {%- set notOpenOtherReasonsOther = allOpen.otherReasons.other._value -%}

      {%- set legalReasons = allOpen.legalReasons._value is true -%}
      {%- set businessReasonsPatents = allOpen.businessReasons._value == 'patents' -%}
      {%- set businessReasonsOther = allOpen.businessReasons._value == 'other' -%}
      {%- set otherReasonsPapers = allOpen.otherReasons._value == 'papers' -%}
      {%- set otherReasonsOther = allOpen.otherReasons._value == 'other' -%}
      {%- set reasons = [legalReasons, businessReasonsPatents, businessReasonsOther, otherReasonsPapers, otherReasonsOther] -%}
      {%- set nReasons = reasons|select("true")|list|length -%}

      {%- if nReasons > 0 -%}
        {%- call macros.para() %}
        {% trans %}The data cannot become completely open because{% endtrans %} 
        {%- if nReasons == 1 -%}
          {%- if legalReasons %}
            {% trans %}of legal reasons.{% endtrans %}
          {%- elif businessReasonsPatents %}
            {% trans %}of patent-related business reasons.{% endtrans %}
          {%- elif businessReasonsOther %}
            {#- TRANSLATORS: %(details)s is ": " followed by the user's text, or just "." -#}
            {% trans details=(": " ~ macros.md(notOpenBusinessReasonsOther) if notOpenBusinessReasonsOther else ".") %}of non-patent business reasons{{ details }}{% endtrans %}
          {%- elif otherReasonsPapers %}
            {% trans %}we want to publish a paper first.{% endtrans %}
          {%- elif otherReasonsOther %}
            {#- TRANSLATORS: %(details)s is ": " followed by the user's text, or just "." -#}
            {% trans details=(": " ~ macros.md(notOpenOtherReasonsOther) if notOpenOtherReasonsOther else ".") %}we have other than paper-publishing reasons{{ details }}{% endtrans %}
          {%- endif -%}
        {%- else %}
          {% trans %}of:{% endtrans %}
          <ul>
            {%- if legalReasons %}
              <li>{% trans %}legal reasons{% endtrans %}</li>
            {%- endif -%}
            {%- if businessReasonsPatents %}
              <li>{% trans %}patent-related business reasons{% endtrans %}</li>
            {%- elif businessReasonsOther %}
              {#- TRANSLATORS: %(details)s is ": " followed by the user's text, or just "." -#}
              <li>{% trans details=(": " ~ macros.md(notOpenBusinessReasonsOther) if notOpenBusinessReasonsOther else "") %}non-patent business reasons{{ details }}{% endtrans %}</li>
            {%- endif -%}
            {%- if otherReasonsPapers %}
              <li>{% trans %}we want to publish a paper first{% endtrans %}</li>
            {%- elif otherReasonsOther -%}
              {#- TRANSLATORS: %(details)s is ": " followed by the user's text, or just "." -#}
              <li>{% trans details=(": " ~ macros.md(notOpenOtherReasonsOther) if notOpenOtherReasonsOther else "") %}we have other than paper-publishing reasons{{ details }}{% endtrans %}</li>
            {%- endif -%}
          </ul>
        {%- endif -%}
        {%- endcall -%}
      {%- else -%}
        <p>{% trans %}The data cannot become completely open.{% endtrans %}</p>
      {%- endif -%}

      {# Authentication and authorization of users #}

      {%- if legalReasons -%}
        {%- set authorisationValue = authorisation._value -%}
        
        {%- if authorisationValue -%}
          <h4>{% trans %}Authentication and Authorization of Users{% endtrans %}</h4>
          {%- if authorisationValue == 'member' -%}
            <p>{% trans %}One of the project members will authorize potential users of the data.{% endtrans %}</p>
          {%- elif authorisationValue == 'committee' -%}
            <p>{% trans %}We will set up a data access committee for authorization of potential users of the data.{% endtrans %}</p>
          {%- elif authorisationValue == 'existingCommittee' -%}
            {%- set existingCommittee = authorisation.committee._value -%}
            
            {%- if existingCommittee -%}
              {%- call macros.para() -%}
                {% trans value=(macros.md(existingCommittee)) %}We will make use of an existing data committee: {{ value }}{% endtrans %}
              {%- endcall -%}
            {%- else -%}
              <p>{% trans %}We will make use of an existing data committee.{% endtrans %}</p>
            {%- endif -%}

          {%- elif authorisationValue == 'other' -%}
            {%- set authorisationOther = authorisation.other._value -%}

            {%- if authorisationOther  -%}
              {%- call macros.para() -%}
                {% trans value=(macros.md(authorisationOther)) %}We will have the following arrangements: {{ value }}{% endtrans %}
              {%- endcall -%}
            {%- else -%}
              <p>{% trans %}We have not decided yet.{% endtrans %}</p>
            {%- endif -%}
          {%- endif -%}
 
        {%- endif -%}

      {%- endif -%}

    {%- endif -%}

    {# Embargo #}
    {%- set embargoValue = embargo._value -%}
    {%- if embargoValue == 'noAllOpen' -%}
      <p>{% trans %}Limited embargo will not be used as all data will be opened.{% endtrans %}</p>
    {%- elif embargoValue == 'noUnrestrictedOpen' -%}
      <p>{% trans %}Limited embargo cannot be used because some restricted data will be embargoed indefinitely.{% endtrans %}</p>
    {%- elif embargoValue == 'noOpenLegal' -%}
      <p>{% trans %}Data will be released only as soon as restrictions are falling away.{% endtrans %}</p>
    {%- elif embargoValue == 'yesEmbargo' -%}
      {%- set embargoPeriod = embargo.period._value -%}
      {%- if embargoPeriod -%}
        <p>{% trans embargoperiod=embargoPeriod %}Data that is not legally restricted will be released after a fixed time period ({{ embargoperiod }}), unconditionally.{% endtrans %}</p>
      {%- else -%}
        <p>{% trans %}Data that is not legally restricted will be released after a fixed time period, unconditionally.{% endtrans %}</p>
      {%- endif -%}
    {%- endif -%}
    
    {# Ownership #}
    {%- set ownershipValue = ownership._value -%}
    {%- if ownershipValue == 'noCopyright' -%}
      <p>{% trans %}Our data is legally not copyrightable, there is no legal owner.{% endtrans %}</p>
    {%- elif ownershipValue == 'pi' -%}
      <p>{% trans %}All data will be owned by the Principal Investigator.{% endtrans %}</p>
    {%- elif ownershipValue == 'institute' -%}
      <p>{% trans %}All data will be owned by the institute.{% endtrans %}</p>
    {%- elif ownershipValue == 'consortiumAgreement' -%}
      <p>{% trans %}We have a consortium agreement that arranges Intellectual Property.{% endtrans %}</p>
    {%- elif ownershipValue == 'other' -%}
      {%- set ownershipOther = ownership.other._value -%}
      {%- if ownershipOther -%}
        {%- call macros.para() -%}
          {% trans value=(macros.md(ownershipOther)) %}We have made the following arrangements regarding the data ownership: {{ value }}{% endtrans %}
        {%- endcall -%}
      {%- endif -%}
    {%- endif -%}

    {# (Non)reference data - license #}
    {%- if preexisting._value is true -%}
      {%- set answeredRefData = [] -%}
      {%- for i in preexisting.referenceDatasets -%}
        {%- set isUsed = i.using._value is true -%}
        {%- set isAnswered = i.using.conditions._value -%}
        {%- if isUsed and isAnswered -%}
          {%- do answeredRefData.append(i) -%}
        {%- endif -%}
      {%- endfor -%}
      {%- set answeredNRefData = [] -%}
      {%- for i in preexisting.nonReferenceDatasets -%}
        {%- set isUsed = i.using._value is true -%}
        {%- set isAnswered = i.using.conditions._value -%}
        {%- if isUsed and isAnswered -%}
          {%- do answeredNRefData.append(i) -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if (answeredRefData|length + answeredNRefData|length) > 0 -%}
        <p>{% trans %}For the reference and non-reference data sets that we reuse, conditions are as follows:{% endtrans %}</p>
        <ul class="entries">
          {%- for i in answeredRefData -%}
            {%- set refDataNameReply = i.dataset._value -%}
            {%- set refDataConditions = i.using.conditions._value -%}
            {%- if refDataConditions -%}
              <li>
                {%- if refDataNameReply -%}
                  <strong>{{ refDataNameReply }}</strong>
                {%- else -%}
                  <strong>{% trans %}(no name given){% endtrans %}</strong>
                {%- endif -%}
                
                {% if refDataConditions == 'cc0' -%}
                  {% trans %}It is freely available for any use (public domain or CC0).{% endtrans %}
                {%- elif refDataConditions == 'cc-by' -%}
                  {% trans %}It is freely available with obligation to quote the source (e.g. CC-BY).{% endtrans %}
                {%- elif refDataConditions == 'restrictions' -%}
                  {%- set refDataConditionsOther = i.using.conditions.conditions._value -%}
                  {#- TRANSLATORS: %(details)s is ": " followed by the user's text, or just "." -#}
                  {% trans details=(": " ~ macros.md(refDataConditionsOther) if refDataConditionsOther else ".") %}It is available under specific restrictions, which we will follow in our project{{ details }}{% endtrans %}
                {%- endif -%}
              </li>
            {%- endif -%}
          {%- endfor -%}
          {%- for i in answeredNRefData -%}
            {%- set nrefDataNameReply = i.dataset._value -%}
            {%- set nrefDataConditions = i.using.conditions._value -%}
            {%- if nrefDataConditions -%}
              <li>
                {%- if nrefDataNameReply -%}
                  <strong>{{ nrefDataNameReply }}</strong>
                {%- else -%}
                  <strong>{% trans %}(no name given){% endtrans %}</strong>
                {%- endif -%}
                {% if nrefDataConditions == 'cc0' -%}
                  {% trans %}It is freely available for any use (public domain or CC0).{% endtrans %}
                {%- elif nrefDataConditions == 'cc-by' -%}
                  {% trans %}It is freely available with obligation to quote the source (e.g. CC-BY).{% endtrans %}
                {%- elif nrefDataConditions == 'restrictions' -%}
                  {%- set nrefDataConditionsOther = i.using.conditions.conditions._value -%}
                  {#- TRANSLATORS: %(details)s is ": " followed by the user's text, or just "." -#}
                  {% trans details=(": " ~ macros.md(nrefDataConditionsOther) if nrefDataConditionsOther else ".") %}It is available under specific restrictions, which we will follow in our project{{ details }}{% endtrans %}
                {%- endif -%}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>
