{#- data -#}
{%- set admin = x.administrativeInformation -%}
{%- set expertise = admin.requiresSpecialist -%}
{%- set hwsw = admin.requiresSpecialHardwareSoftware -%}
{%- set projects = admin.projects -%}

<div id="q-required-resources" class="question">
  <h3>{% trans %}15. What resources (for example financial and time) will be dedicated to data management and ensuring that data will be FAIR (Findable, Accessible, Interoperable, Re-usable)?{% endtrans %}</h3>

  <div class="answer">
    {# additional expertise #}
    {%- if expertise._value == 'no' -%}
      <p>{% trans %}To execute the DMP, no additional specialist expertise is required.{% endtrans %}</p>
    {%- elif expertise._value == 'available' -%}
      <p>{% trans %}To execute the DMP, additional specialist expertise is required and we have such trained support staff available.{% endtrans %}</p>
    {%- elif expertise._value == 'training' -%}
      {% call macros.para() %}
        {% trans %}To execute the DMP, additional specialist expertise is required. We will be training existing staff{% endtrans %}
        {%- set expertiseTrainText = expertise.training._value -%}
        {%- if expertiseTrainText %}
          {{ " " }}{% trans value=(macros.md(expertiseTrainText)) %}on: {{ value }}{% endtrans %}
        {%- else -%}
          .
        {%- endif -%}
      {% endcall %}
    {%- elif expertise._value == 'expertise' -%}
      <p>
        {% trans %}To execute the DMP, additional specialist expertise is required. We will be hiring new people with additional expertise{% endtrans %}
        {%- set expertiseHireText = expertise.expertise._value -%}
        {%- if expertiseHireText %}
          {{ " " }}{% trans expertisehiretext=(expertiseHireText|trim|dot) %}in: {{ expertisehiretext }}{% endtrans %}
        {%- else -%}
          .
        {%- endif -%}
      </p>
    {%- endif -%}
    {# additional hw/sw #}
    {%- if hwsw._value is false -%}
      <p>{% trans %}We do not require any hardware or software in addition to what is usually available in the institute.{% endtrans %}</p>
    {%- elif hwsw._value is true -%}
      {%- set additionalHWSWWhat = hwsw.needs._value -%}
      {%- if additionalHWSWWhat -%}
        {% call macros.para() %}{% trans value=(macros.md(additionalHWSWWhat)) %}We require the following hardware or software in addition to what is usually available in the institute: {{ value }}{% endtrans %}{% endcall %}
      {%- else -%}
        <p>{% trans %}We require hardware or software in addition to what is usually available in the institute.{% endtrans %}</p>
      {%- endif -%}
    {%- endif -%}
    {# charges #}
    <p>{% trans %}Charges applied by data repositories (if any) are mentioned already in Section 5, Question 11.{% endtrans %}</p>
    {# costs #}
    {%- if projects|length > 0 -%}
    <p>{% trans %}The following resources will be dedicated to data management and ensuring that data will be FAIR:{% endtrans %}</p>
    <ul class="entries">
        {%- for project in projects -%}
            {%- set projectItemNameReply = project.name._value -%}

            {%- set projectItemNumberReply = project.id._value -%}
            <li> 
                <strong>{{ projectItemNameReply if projectItemNameReply else _("(no name given)") }}{{ " - " + projectItemNumberReply if projectItemNumberReply}} </strong>

                {%- set projectCostItems = project.costs -%}

                {%- if projectCostItems|length > 0  -%}
                    <ul>
                    {%- for cost in projectCostItems -%}
                        {%- set projectCostItemDescriptionReply = cost.description._value -%}
                        <li>
                        <strong>{{ projectCostItemDescriptionReply if projectCostItemDescriptionReply else _("(no description given)") }}</strong>

                        {%- set projectCostItemCurrency = cost.currency -%}
                        {%- set projectCostItemAmountReply = cost.amount._value -%}

                        {%- if projectCostItemAmountReply not in [none, ''] and projectCostItemCurrency._value is not none -%}
                            <p>{% trans amount=projectCostItemAmountReply, currency=(macros.currency(projectCostItemCurrency)) %}The amount is {{ amount }} {{ currency }}.{% endtrans %}</p>
                        {%- endif -%}

                        {%- set projectCostItemAllocationItems = cost.allocation|map(attribute='_value')|list -%}

                        
                          {%- set projectCostItemAllocations = [] -%}
                          {%- if 'findability' in projectCostItemAllocationItems -%}
                            {%- do projectCostItemAllocations.append(_("ensuring findability")) -%}
                          {%- endif -%}
                          {%- if 'accessibility' in projectCostItemAllocationItems -%}
                            {%- do projectCostItemAllocations.append(_("ensuring accessibility")) -%}
                          {%- endif -%}
                          {%- if 'interoperability' in projectCostItemAllocationItems -%}
                            {%- do projectCostItemAllocations.append(_("ensuring interoperability")) -%}
                          {%- endif -%}
                          {%- if 'reusability' in projectCostItemAllocationItems -%}
                            {%- do projectCostItemAllocations.append(_("ensuring reusability")) -%}
                          {%- endif -%}
                          {%- if 'management' in projectCostItemAllocationItems -%}
                            {%- do projectCostItemAllocations.append(_("supporting management")) -%}
                          {%- endif -%}
                        
                        {%- if projectCostItemAllocations|length > 0 -%}
                          <p>
                            {% trans %}This resource is allocated for{% endtrans %}{{+" "}}
                            {%- if projectCostItemAllocations|length > 2 -%}
                              {#- TRANSLATORS: completes "This resource is allocated for"; the purposes are "ensuring findability" etc. -#}
                              {% trans purposes=(projectCostItemAllocations[0:-1]|join(", ")), last_purpose=(projectCostItemAllocations[-1]) %}{{ purposes }}, and {{ last_purpose }} of data.{% endtrans %}
                            {%- elif projectCostItemAllocations|length == 2 -%}
                              {% trans purpose=(projectCostItemAllocations[0]), purpose2=(projectCostItemAllocations[1]) %}{{ purpose }} and {{ purpose2 }} of data.{% endtrans %}
                            {%- else -%}
                              {% trans purpose=(projectCostItemAllocations[0]) %}{{ purpose }} of data.{% endtrans %}
                            {%- endif %}
                          </p>
                        {%- endif -%}
                       
 
                        {%- set coveredBy = cost.coveredBy -%}

                        {%- if coveredBy._value == 'grant' -%}
                          {#- the selected funding of the project -#}
                          {%- set funding = project.fundings|selectattr('_uuid', 'equalto', coveredBy.grantID.get('_uuid'))|first -%}
                          {%- set costCoverGrantIdReply = funding.grantNumber._value if funding else none -%}
                          <p>{% trans %}This cost will be covered by funding grant{% endtrans %}
                          {%- if costCoverGrantIdReply -%}
                            {{ " " }}{% trans costcovergrantidreply=costCoverGrantIdReply %}(grant number: {{ costcovergrantidreply }}){% endtrans %}
                          {%- else -%}
                            .
                          {%- endif -%}
                          </p>
                        {%- elif coveredBy._value == 'other' -%}
                          {%- set costCoverOtherHowReply = coveredBy.description._value -%}
                          {%- if costCoverOtherHowReply -%}
                            <p>{% trans costcoverotherhowreply=costCoverOtherHowReply %}This cost will be covered as follows: {{ costcoverotherhowreply }}.{% endtrans %}</p>
                          {%- endif -%}

                        {%- endif -%}


                        </li>
                    {%- endfor -%}
                    </ul>
                {%- endif -%}

            </li>

        {%- endfor -%}
    </ul>
    {%- endif -%}
  </div>
</div>
