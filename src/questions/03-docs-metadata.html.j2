{#- data -#}
{%- set metadata = x.creatingData.collectingMetadata -%}
{%- set openMetadata = x.givingAccessToData.openMetadata -%}
{%- set storageConv = x.processingData.storageNamingConventions -%}

<div id="q-docs-metadata" class="question">
  <h3>{% trans %}3. What metadata and documentation (for example the methodology of data collection and way of organizing data) will accompany the data?{% endtrans %}</h3>

  <div class="answer">
    <p>{% trans %}List of data to be published is given in Section 5, Questions 10 and 11. This also includes information about catalogs where the data can be found. Information about data types used is given in Section 1, Question 2.{% endtrans %}</p>

    {# Metadata #}
    {%- if metadata._value == 'explore' -%}

      {# Metadata standards #}
      {%- set metadataSentences = [] -%}
      {%- set standards = [] -%}
      {%- for item in metadata.standards if item.standard._value -%}
        {%- do standards.append(macros.fairsharing(item.standard)) -%}
      {%- endfor -%}
      {%- if standards|length == 1 -%}
        {%- do metadataSentences.append(_("We will be documenting the data with the %(standard)s metadata standard.", standard=standards[0])) -%}
      {%- elif standards|length == 2 -%}
        {%- do metadataSentences.append(_("We will be documenting the data with the %(standard)s and %(standard2)s metadata standards.", standard=standards[0], standard2=standards[1])) -%}
      {%- elif standards|length > 2 -%}
        {%- do metadataSentences.append(_("We will be documenting the data with the %(standard)s, %(standard2)s, and %(standard3)s metadata standards.", standard=standards[:-2]|join(", "), standard2=standards[-2], standard3=standards[-1])) -%}
      {%- endif -%}

      {# Provenance standards #}
      {%- set provenance = [] -%}
      {%- for item in metadata.standardsProvenance if item.standardProvenance._value -%}
        {%- do provenance.append(macros.fairsharing(item.standardProvenance)) -%}
      {%- endfor -%}
      {%- if provenance|length == 1 -%}
        {%- do metadataSentences.append(_("The provenance will be captured using %(standard)s.", standard=provenance[0])) -%}
      {%- elif provenance|length == 2 -%}
        {%- do metadataSentences.append(_("The provenance will be captured using %(standard)s and %(standard2)s.", standard=provenance[0], standard2=provenance[1])) -%}
      {%- elif provenance|length > 2 -%}
        {%- do metadataSentences.append(_("The provenance will be captured using %(standard)s, %(standard2)s, and %(standard3)s.", standard=provenance[:-2]|join(", "), standard2=provenance[-2], standard3=provenance[-1])) -%}
      {%- endif -%}

      {%- if metadataSentences|length > 0 -%}
        <p>{{ metadataSentences|join(" ") }}</p>
      {%- endif -%}
    {%- endif -%}

    {# Publishing metadata #}
    {%- if openMetadata._value is false %}
      {%- set explanation = openMetadata.explanation._value -%}
      {%- if explanation -%}
        {% call macros.para() %}{% trans value=(macros.md(explanation)) %}Metadata will not be available openly &ndash; {{ value }}{% endtrans %}{% endcall %}
      {%- else -%}
        <p>{% trans %}Metadata will not be available openly.{% endtrans %}</p>
      {%- endif -%}
    {%- elif openMetadata._value is true -%}
      {%- set accessInstructions = openMetadata.accessInstructions._value -%}
      {%- set harvestable = openMetadata.harvestable._value -%}
      <p>
      {%- if accessInstructions is true %}
        {% trans %}Metadata will be openly available including instructions how to get access to the data.{% endtrans %}
      {%- elif accessInstructions is false %}
        {% trans %}Metadata will be openly available without instructions how to get access to the data.{% endtrans %}
      {%- else %}
        {% trans %}Metadata will be openly available.{% endtrans %}
      {%- endif %}
      {%- if harvestable == 'no' %}
        {% trans %}Metadata will not be available in a form that can be harvested and indexed.{% endtrans %}
      {%- elif harvestable == 'byRepository' %}
        {% trans %}Metadata will be available in a form that can be harvested and indexed (managed by the used repository / repositories).{% endtrans %}
      {%- elif harvestable == 'yes' %}
        {% trans %}Metadata will be available in a form that can be harvested and indexed.{% endtrans %}
      {%- endif %}
      </p>
    {%- endif -%}

  {# Storage and file conventions #}
  {%- if storageConv._value == 'explore' -%}
    {%- set storageSpace = storageConv.storageNeeds -%}
    {%- set filesFolders = storageConv.filesFolders -%}
    {%- set objectStore = storageConv.objectStore -%}
    {%- set database = storageConv.databaseSystem -%}
    {%- if filesFolders._value is not none or objectStore._value is not none or database._value is not none -%}
      <h4>{% trans %}Data storage and file conventions{% endtrans %}</h4>
      {# Storage space #}
      {%- if storageSpace._value == 'little' -%}
        <p>{% trans %}The project will require so little storage space for all data and software (including temporary storage) that it is not a problem.{% endtrans %}</p>
      {%- elif storageSpace._value == 'specify' -%}
        {%- set size = storageSpace.gigabytes._value -%}
        {%- if size -%}
        <p>{% trans size=size %}We estimate the storage space that the project will require for all data and software (including temporary storage) to {{ size }} gigabytes.{% endtrans %}</p>
        {%- endif -%}
      {%- endif -%}
      {# File System #}
      {% call macros.para() %}
      {%- if filesFolders._value is false -%}
        {% trans %}We will not use a filesystem with files and folders.{% endtrans %}
      {%- elif filesFolders._value is true -%}
        {# Folder types #}
        {%- set subjectFolders = filesFolders.folderSample._value is true -%}
        {%- set analysisFolders = filesFolders.folderAnalysis._value is true -%}
        {%- set workflowStepFolders = filesFolders.folderWorkflowStep._value is true -%}
        {%- set folders = [subjectFolders, analysisFolders, workflowStepFolders] -%}
        {%- if folders|any -%}
          {% trans %}We will use a filesystem with files and folders with the following folder conventions:{% endtrans %}
          <ul>
            {%- if subjectFolders -%}
              {%- set scFSysSubjFoldersConvs = filesFolders.folderSample.convention._value -%}
              <li>
                {% trans %}There will be a <strong>folder for each sample/subject</strong>.{% endtrans %}
                {% if scFSysSubjFoldersConvs %}
                  {% trans value=(macros.md(scFSysSubjFoldersConvs)) %}Each of those will use the following conventions: {{ value }}{% endtrans %}
                {%- endif -%}
              </li>
            {%- endif -%}
            {%- if analysisFolders -%}
              {%- set scFSysAnalysisFoldersConvs = filesFolders.folderAnalysis.convention._value -%}
              <li>
                {% trans %}There will be a <strong>(sub)folder for each (repeated) analysis</strong>.{% endtrans %} 
                {% if scFSysAnalysisFoldersConvs %}
                  {% trans value=(macros.md(scFSysAnalysisFoldersConvs)) %}Each of those will use the following conventions: {{ value }}{% endtrans %}
                {%- endif -%}
              </li>
            {%- endif -%}
            {%- if workflowStepFolders -%}
              {%- set scFSysWorkflowStepFoldersConvs = filesFolders.folderWorkflowStep.convention._value -%}
              <li>
                {% trans %}There will be a <strong>(sub)folder for each step in the analysis workflow</strong>.{% endtrans %}
                {% if scFSysWorkflowStepFoldersConvs %}
                  {% trans value=(macros.md(scFSysWorkflowStepFoldersConvs)) %}Each of those will use the following conventions: {{ value }}{% endtrans %}
                {%- endif -%}
              </li>
            {%- endif -%}
          </ul>
        {%- else -%}
          {% trans %}We will use a filesystem with files and folders.{% endtrans %}
        {%- endif -%}
        {# Versioning #}
        {%- if filesFolders.fileVersioningDocs._value is true %}
          {% trans %}We document how we manage file versioning for files and folders.{% endtrans %}
        {%- endif -%}
        {# Other appointments #}
        {%- set scFSysAppointments = filesFolders.fileNaming._value -%}
        {%- if scFSysAppointments %}
          {% if folders|any %}{% trans value=(macros.md(scFSysAppointments[:1]|upper ~ scFSysAppointments[1:])) %}Moreover, we have made agreements on naming the files. {{ value }}{% endtrans %}{% else %}{% trans value=(macros.md(scFSysAppointments[:1]|upper ~ scFSysAppointments[1:])) %}We have made agreements on naming the files. {{ value }}{% endtrans %}{% endif %}
        {%- endif -%}
      {%- endif -%}
      {% endcall %}
      {# Object and Document Store #}
      {% call macros.para() %}
      {%- if objectStore._value is false -%}
        {% trans %}We will not be storing data in an "object/document store" system.{% endtrans %}
      {%- elif objectStore._value is true -%}
        {%- set scObjStoreNaming = objectStore.convention._value -%}
        {%- if scObjStoreNaming -%} 
          {% trans value=(macros.md(scObjStoreNaming)) %}We will be storing data in an "object/document store" system using the following naming conventions for objects in the store: {{ value }}{% endtrans %}
        {%- else -%}
          {% trans %}We will be storing data in an "object/document store" system.{% endtrans %}
        {%- endif -%}
      {%- endif -%}
      {% endcall %}
      {# Databases #}
      <p>
      {%- if database._value is false -%}
        {% trans %}We will not use a database system to store project data.{% endtrans %}
      {%- elif database._value is true -%}
        {% trans %}We will use a database system to store project data.{% endtrans %}
        {%- set changeHandling = database.changeHandling._value -%}
        {%- if changeHandling == 'readOnly' %}
          {% trans %}Data in the database will be read-only.{% endtrans %}
        {%- elif changeHandling == 'crud' %}
          {% trans %}We will be allowing Create, Update and Delete operations for data in the database.{% endtrans %}
        {%- elif changeHandling == 'expireAdd' %}
          {% trans %}Modifications will be made by <em>Expiring</em> the existing data and <em>Adding</em> updated data.{% endtrans %}
        {%- endif -%}
      {%- endif -%}
      </p>
    {%- endif -%}
  {%- endif -%}

  </div>
</div>
