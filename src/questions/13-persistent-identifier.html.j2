{#- data -#}
{%- set datasets = x.preservingData.producedDatasets -%}
{%- set measured = x.creatingData.hasMeasuredData -%}

<div id="q-persistent-identifier" class="question">
    <h3>{% trans %}13. How will the application of a unique and persistent identifier (such as a Digital Object Identifier (DOI)) to each data set be ensured?{% endtrans %}</h3>

    <div class="answer">
    {# identifiers #}
    <h4>{% trans %}Ensuring PIDs for published data{% endtrans %}</h4>
    {%- if datasets|length > 0 -%}
        <ul class="entries">
        {%- for dataset in datasets -%}
            {%- set producedDataName = dataset.dataset._value -%}
            {# If will be published #}
            {%- set published = dataset.published -%}
            {% if published._value is true %}
            <li>
                <strong>{{ producedDataName if producedDataName else _("(no name given)") }}</strong>
                {# Where the data will be distributed #}
                {%- set publishedDistrosItems = published.distributions -%}
                    {%- if publishedDistrosItems|length > 0  -%}
                    <p>{% trans count=[publishedDistrosItems|length, 1]|max %}This data will be distributed in the following repository:{% pluralize %}This data will be distributed in the following repositories:{% endtrans %}</p>
                    <ul>
                        {%- for distribution in publishedDistrosItems -%}
                            {%- set assignPid = distribution.assignPid -%}
                            {%- set repositoryKind = distribution.repository._value -%}
                            <li>
                            {%- if repositoryKind == 'domainSpecific' -%}
                                <strong>{% trans %}Domain-specific repository{% endtrans %}</strong>
                            {%- elif repositoryKind == 'generalPurpose' -%}
                                <strong>{% trans %}General-purpose repository{% endtrans %}</strong>
                            {%- elif repositoryKind == 'national' -%}
                               <strong>{% trans %}National repository{% endtrans %}</strong>
                            {%- elif repositoryKind == 'institutional' -%}
                                <strong>{% trans %}Institutional repository{% endtrans %}</strong>
                            {%- elif repositoryKind == 'specialPurpose' -%}
                                <strong>{% trans %}Special-purpose repository{% endtrans %}</strong>
                            {%- endif -%}

                            {# Will this data be assigned persistent identifier? #}
                            {%- if assignPid._value is true -%}
                            <p>{% trans %}Within this repository, unique and persistent identifiers will be applied as follows:{% endtrans %}</p>
                            <ul>
                                {# Who assigns #}
                                {%- set assigner = assignPid.assigner._value -%}

                                {%- if assigner == 'project' -%}
                                    <li>{% trans %}A project data steward or principal investigator will assign the persistent identifier.{% endtrans %}</li>

                                {%- elif assigner == 'institution' -%}
                                    <li>{% trans %}An institutional data steward will assign the persistent identifier.{% endtrans %}</li>

                                {%- elif assigner == 'repository' -%}
                                    <li>{% trans %}The repository will assign the persistent identifier.{% endtrans %}</li>
                                {%- endif -%}

                                {# Resolvable #}
                                {%- set resolvable = assignPid.pidResolvable._value -%}

                                {%- if resolvable is true -%}
                                    <li>{% trans %}The repository will make sure the persistent identifier can be resolved to a digital object.{% endtrans %}</li>

                                {%- elif resolvable is false -%}
                                    <li>{% trans %}The repository will not make sure the persistent identifier can be resolved to a digital object.{% endtrans %}</li>
                                {%- endif -%}

                            </ul>
                            {%- elif assignPid._value is false -%}
                            <p>{% trans %}Within this repository, unique and persistent identifiers will not be applied.{% endtrans %}</p>
                            {%- endif -%}
                            </li>
                        {%- endfor -%}
                    </ul>
                    {%- endif -%}
            </li>
            {%- endif -%}
        {%- endfor -%}
        </ul>
    {%- endif -%}

    {# Explain how the data might be re-used in other contexts. #}
    <h4>{% trans %}Possible re-use of created data in other contexts{% endtrans %}</h4>
    <p>{% trans %}Explanation of how the collected or created data might be re-used in other contexts:{% endtrans %}</p>

    {%- if measured._value is true  -%}

        {%- set dataMeasuredItems = measured.datasets -%}
        <ul class="entries">
        {%- for measuredDataset in dataMeasuredItems -%}
            {%- set measuredDataNameReply = measuredDataset.dataset._value -%}
            <li>
            <strong>{{ measuredDataNameReply if measuredDataNameReply else _("(no name given)") }}</strong>
            {%- set whoInterested = measuredDataset.whoInterested -%}

            {%- if whoInterested._value == 'justUs' -%}
                <p>{% trans %}Only we will be interested in re-using this data.{% endtrans %}</p>

            {%- elif whoInterested._value == 'sameField'  -%}
                <p>{% trans %}Other researchers in this field will be interested in re-using this data.{% endtrans %}</p>
            {%- elif whoInterested._value == 'otherFields' -%}
                {%- set measuredDataReuseOtherFieldHowReply = whoInterested.how._value -%}

                {% call macros.para() %}
                    {% trans %}Researchers working in other fields will be interested in re-using this data{% endtrans %}
                    {%- if measuredDataReuseOtherFieldHowReply -%}
                        {{ " " }}{% trans value=(macros.md(measuredDataReuseOtherFieldHowReply)) %}because: {{ value }}{% endtrans %}
                    {%- else -%}
                        .
                    {%- endif -%}
                {% endcall %}

            {%- endif -%}
            </li>
        {%- endfor -%}
        </ul>

    {%- endif -%}



    </div>
</div>
