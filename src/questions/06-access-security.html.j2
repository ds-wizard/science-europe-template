{#- data -#}
{%- set dataRisks = x.processingData.dataLossLeakVandalismRisks -%}
{%- set carryHome = dataRisks.membersCarryData -%}
{%- set personalData = dataRisks.personalDataProtection -%}
{%- set pseudonymization = personalData.pseudonymization -%}
{%- set workspace = x.processingData.sharedWorkingSpace -%}
{%- set reliability = workspace.reliability -%}
{%- set archivedDuring = x.preservingData.coldStorageDuringProject -%}
{%- set rearchival = archivedDuring.needsRearchival -%}
{%- set policies = x.administrativeInformation.policies -%}

<div id="q-access-security" class="question">
  <h3>{% trans %}6. How will data security and protection of sensitive data be taken care of during the research?{% endtrans %}</h3>

  <div class="answer">
    {#- Basic risks #}
    {%- set homeEncrypted = carryHome.encrypted._value is true -%}
    {%- set homePassword = carryHome.passwordProtected._value is true -%}
    {%- set storeLab = dataRisks.storeLabExternalHardDrives._value is false -%}

    {%- if storeLab or (carryHome._value is false) or (carryHome._value is true and (homeEncrypted or homePassword)) or (dataRisks.certifiedDataCentres._value is true) or (dataRisks.httpsWebServices._value is true) or (dataRisks.membersInstructedAboutRisks._value is true) %}
      <p>
        {%- if storeLab %}
          {% trans %}Project members will not store data or software on computers in the lab or external hard drives connected to those computers.{% endtrans %}{{ " " }}
        {%- endif -%}
        {%- if carryHome._value is false %}
          {%- if storeLab -%}{% trans %}They{% endtrans %}{%- else -%}{% trans %}Project members{% endtrans %}{%- endif %} {% trans %}will not carry data with them (e.g. on laptops, USB sticks, or other external media).{% endtrans %}
        {%- elif homeEncrypted and homePassword %}
          {%- if storeLab -%}{% trans %}They{% endtrans %}{%- else -%}{% trans %}Project members{% endtrans %}{%- endif %} {% trans %}can carry data with them on encrypted data carriers and password-protected laptops.{% endtrans %}
        {%- elif homeEncrypted %}
          {%- if storeLab -%}{% trans %}They{% endtrans %}{%- else -%}{% trans %}Project members{% endtrans %}{%- endif %} {% trans %}can carry data with them on encrypted data carriers.{% endtrans %}
        {%- elif homePassword %}
          {%- if storeLab -%}{% trans %}They{% endtrans %}{%- else -%}{% trans %}Project members{% endtrans %}{%- endif %} {% trans %}can carry data with them on password-protected laptops.{% endtrans %}
        {%- endif -%}
        {%- if dataRisks.certifiedDataCentres._value is true %}
          {% trans %}All data centers where project data is stored hold appropriate certifications.{% endtrans %}
        {%- endif -%}
        {%- if dataRisks.httpsWebServices._value is true %}
          {% trans %}All project web services are accessible via secure HTTP (https://...).{% endtrans %}
        {%- endif -%}
        {%- if dataRisks.membersInstructedAboutRisks._value is true %}
          {% trans %}Project members have been instructed about both generic and specific risks to the project.{% endtrans %}
        {%- endif -%}
      </p>
    {%- endif -%}
    {# Information loss, leak, and vandalism #}

    {#- Define mapping of answer codes to qualitative levels #}
    {%- set risk_levels = {
      'negligible': 'small',
      'acceptablyLow': 'low',
      'needWork': 'will'
    } -%}

    {# Extract selected levels for each type #}
    {%- set selected = {
      'loss': risk_levels[dataRisks.considerLossImpact._value],
      'leak': risk_levels[dataRisks.considerLeakImpact._value],
      'vandalism': risk_levels[dataRisks.considerVandalismImpact._value]
    } -%}

    {#- TRANSLATORS: kinds of information risk, used in "The possible impact of information %(risks)s is small" and similar sentences -#}
    {%- set riskNames = {'loss': _('loss'), 'leak': _('leak'), 'vandalism': _('vandalism')} -%}
    {%- set small = [] -%}
    {%- set low = [] -%}
    {%- set will = [] -%}

    {# simple grouping in one pass #}
    {%- for key, level in selected.items() -%}
      {%- if level == 'small' -%}
        {%- do small.append(riskNames[key]) -%}
      {%- elif level == 'low' -%}
        {%- do low.append(riskNames[key]) -%}
      {%- elif level == 'will' -%}
        {%- do will.append(riskNames[key]) -%}
      {%- endif -%}
    {%- endfor -%}

    {# helper inline join #}
    {%- set fragments = [] -%}
    {%- if small|length > 0 -%}
      {%- set risks = (small[:-1]|join(', ') ~ _(', and ') ~ small[-1]) if small|length > 1 else small[0] -%}
      {%- do fragments.append(_("The possible impact of information %(risks)s is small", risks=risks)) -%}
    {%- endif -%}
    {%- if low|length > 0 -%}
      {%- set risks = (low[:-1]|join(', ') ~ _(', and ') ~ low[-1]) if low|length > 1 else low[0] -%}
      {%- do fragments.append(_("The risk of information %(risks)s is acceptably low", risks=risks)) -%}
    {%- endif -%}
    {%- if will|length > 0 -%}
      {%- set risks = (will[:-1]|join(', ') ~ _(', and ') ~ will[-1]) if will|length > 1 else will[0] -%}
      {%- do fragments.append(_("We will mitigate the risk of information %(risks)s", risks=risks)) -%}
    {%- endif -%}
    {%- if fragments|length > 0 -%}
      <p>{{ fragments | join('. ') }}.</p>
    {%- endif -%}
    {# Personal data #}
    {%- if personalData._value == 'noPersonalData' -%}
      <p>{% trans %}We are not using any personal information.{% endtrans %}</p>
    {%- elif personalData._value == 'pseudonymizedOnly' -%}
      {%- call macros.para() %}
        {% trans %}All personal information will be processed in pseudonymized form only.{% endtrans %}
        {%- if pseudonymization._value == 'insideProjectLimitedPeopleKey' %}
          {% trans %}We pseudonymize inside the project, only a limited number of people can access the keys.{% endtrans %}
        {%- elif pseudonymization._value == 'independentParty' %}
          {% trans %}Pseudonymization is handled by an independent party in order to allow data coupling.{% endtrans %}
        {%- elif pseudonymization._value == 'other' -%}
          {%- set pseudonymizationOther = pseudonymization.other._value %}
          {#- TRANSLATORS: %(details)s is ": " followed by the user's text, or just "." -#}
          {% trans details=(": " ~ macros.md(pseudonymizationOther) if pseudonymizationOther else ".") %}We have a specific way of pseudonymization{{ details }}{% endtrans %}
        {%- endif -%}
      {%- endcall -%}
    {%- elif personalData._value == 'anonymouslyCollected' -%}
      <p>{% trans %}All personal data will be collected anonymously.{% endtrans %}</p>
    {%- elif personalData._value == 'anonymisedEarly' -%}
      <p>{% trans %}All personal data will be anonymized as early as possible.{% endtrans %}</p>
    {%- endif -%}


    {# Shared Workspace #}
    {%- set preventLoss = reliability.dataLossPrevention._value -%}
    {%- if workspace._value is true and preventLoss -%}
     <p>{% trans %}During the project we will use shared working space to work with our data{% endtrans %}{{+" "}}
      {%- if preventLoss == 'sufficient'  -%}
        {% trans %}that ensures the prevention of complete data loss.{% endtrans %}
      {%- elif preventLoss == 'duplication' -%}
        {% trans %}but we will store all essential data elsewhere.{% endtrans %}
      {%- endif -%}

      {%- set backup = reliability.otherBackup._value -%}
      {%- if backup == 'allBackedUp' -%}
        {{+" "}}{% trans %}All the data stored elsewhere are adequately backed up.{% endtrans %}
      {%- elif backup == 'automatedBackups' -%}
        {{+" "}}{% trans %}We make (automated) backups of all data stored outside of the working area.{% endtrans %}
      {%- endif -%}
     </p>

    {%- endif -%}

    {# Long term preservation and recovery #}
    {%- if archivedDuring._value is true -%}
      <p>{% trans %}We will be archiving data for long-term preservation already during our project.{% endtrans %}

      {%- if rearchival._value is true -%}
        {{ " " }}{% trans %}The archived data will be changing over time and needs re-archival.{% endtrans %}
        {%- set frequentBackups = rearchival.frequentBackups._value -%}
        {%- set relyOnBackups = rearchival.recoverHumanError._value is true -%}

        {%- if (frequentBackups is true) and relyOnBackups -%}
          {{ " " }}{% trans %}This data needs frequent backups and we will rely on these backups in case of recovery from human errors.{% endtrans %}
        {%- elif (frequentBackups is false) and relyOnBackups -%}
          {{ " " }}{% trans %}This data will be infrequently backed up and we will rely on these backups in case of recovery from human errors.{% endtrans %}
        {%- endif -%}

      {%- endif -%}
      </p>
    {%- endif -%}

    {# Access control in shared workspace #}
    {%- set accessControl = workspace.accessControl._value -%}
    {%- if accessControl -%}
      <h4>{% trans %}Access to data during research{% endtrans %}</h4>
      {%- if accessControl == 'onlyMembersReadWrite' -%}
        <p>{% trans %}All project members, and nobody else, have read/write access to the data.{% endtrans %}</p>
      {%- elif accessControl == 'instituteReadMembersWrite' -%}
        <p>{% trans %}Anyone in the institute has read access to the data; all project members have read/write access.{% endtrans %}</p>
      {%- elif accessControl == 'membersReadSelectedWrite' -%}
        <p>{% trans %}Only project members will have read access; only selected project members will be able to write data.{% endtrans %}</p>
      {%- elif accessControl == 'instituteReadMembersRequest' -%}
        <p>{% trans %}Anyone in the institute can read data, only project members can request write access.{% endtrans %}</p>
      {%- endif -%}
    {%- endif -%}

    {# Policies and Procedures for DMP #}
    {%- if policies|length > 0 -%}
      <h4>{% trans %}Policies and Procedures{% endtrans %}</h4>
      <p> {% trans %}We will use the following policies and procedures:{% endtrans %} </p>
      <ul class="entries">
        {%- for policy in policies -%}
          <li>
            {%- set policyName = policy.name._value -%}
            {%- set policyLink = policy.url._value -%}
            {%- set policyDescription = policy.description._value -%}
              <strong>{{ policyName if policyName else _("(no name given)") }}</strong>
              {%- if policyLink %}
                <span class="separator">&ndash;</span>
                {% if policyLink.startswith("http://") or policyLink.startswith("https://") -%}
                  <a href="{{ policyLink }}" target="_blank">{{ policyLink }}</a>
                {%- else -%}
                  {{ policyLink }}
                {%- endif -%}
              {%- endif -%}
              {%- if policyDescription -%}
                {% call macros.para() %}{{ macros.md(policyDescription) }}{% endcall %}
              {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>