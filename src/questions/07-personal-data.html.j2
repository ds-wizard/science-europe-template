{#- data -#}
{%- set collectsPersonal = x.creatingData.collectsPersonalData -%}
{%- set gdpr = collectsPersonal.gdpr -%}
{%- set safeguards = gdpr.safeguards -%}
{%- set legalReasons = x.givingAccessToData.allOpenOverTime.legalReasons -%}

<div id="q-personal-data" class="question">
    <h3>{% trans %}7. If personal data are processed, how will compliance with legislation on personal data and on security be ensured?{% endtrans %}</h3>

    <div class="answer">
        <p>{% trans %}Data security protection is described in Section 3, Question 6.{% endtrans %}</p>
        {%- if collectsPersonal._value is true -%}
            
            {%- if gdpr._value == 'explore' -%}
                {# Legal basis #}
                {%- set legalBasis = gdpr.legalBasis._value -%}
                {%- if legalBasis  -%}
                    <h4>{% trans %}Legal basis for collecting and processing personal data{% endtrans %}</h4>
                    <p>{% trans %}We are collecting and processing personal data{% endtrans %}{{+" "}}
                    {%- if legalBasis == 'publicInterest' -%}
                        {% trans %}based on public interest.{% endtrans %}
                    {%- elif legalBasis == 'consent' -%}
                        {% trans %}based on the subject's consent.{% endtrans %}
                    {%- elif legalBasis == 'other' -%}
                        {%- set legalBasisOther = gdpr.legalBasis.other._value -%}
                        {%- if legalBasisOther == 'contract' -%}
                            {% trans %}in order to fulfil a contract.{% endtrans %}
                        {%- elif legalBasisOther == 'legitimateInterest' -%}
                            {% trans %}based on legitimate interest.{% endtrans %}
                        {%- elif legalBasisOther == 'vitalInterest' -%}
                            {% trans %}based on vital interest.{% endtrans %}
                        {%- elif legalBasisOther == 'legalRequirement' -%}
                            {% trans %}based on legal requirement.{% endtrans %}
                        {%- endif -%}
                    {%- endif -%}
                    </p>
                {%- endif -%}

                {# Technical and procedural safeguards #}
                {%- if safeguards._value == 'specify' -%}

                    <h4>{% trans %}Technical and procedural measures{% endtrans %}</h4>

                    {%- set identifiability = safeguards.identifiabilityLevel._value -%}

                    {%- if identifiability == 'anonymized' -%}
                        <p>{% trans %}The stored data are irrevocably anonymized.{% endtrans %}</p>
                    {%- elif identifiability == 'pseudonymized' -%}
                        <p>{% trans %}The stored data are pseudonymized.{% endtrans %}</p>
                    {%- elif identifiability == 'identifiable' -%}
                        <p>{% trans %}The stored data are identifiable.{% endtrans %}</p>
                    {%- endif -%}

                    {%- set safeguardsDescription = safeguards.description._value -%}
                    {%- if safeguardsDescription -%}
                        {%- call macros.para() -%}
                            {% trans value=(macros.md(safeguardsDescription)) %}We will use the following technical and procedural safeguards: {{ value }}{% endtrans %}
                        {%- endcall -%}
                    {%- endif -%}

                    {%- set transferMeasures = safeguards.transferOutsideEu.description._value -%}

                    {%- if (safeguards.transferOutsideEu._value is true) and (transferMeasures) -%}
                        {%- call macros.para() -%}
                            {% trans value=(macros.md(transferMeasures)) %}We plan to transfer data outside the EU/EEA and these are the measures we will put in place to protect the data:
                        {{ value }}{% endtrans %}
                        {%- endcall -%}
                    {%- endif -%}
                {%- endif -%}
            {%- endif -%}
        {%- elif collectsPersonal._value is false -%}
        <p>{% trans %}We will not collect any data related to individuals.{% endtrans %}</p>
        {%- endif -%}

        {# Managed access procedure to personal data #}
        {%- if legalReasons._value is true -%}

            {%- if legalReasons.privacyReasons._value is true -%}

                {%- set accessProcedure = legalReasons.privacyReasons.procedure._value -%}
                
                {%- if accessProcedure -%}
                    <h4>{% trans %}Access procedure to personal data{% endtrans %}</h4>
                    <p>{% trans personaldatamanagedaccessreply=accessProcedure %}There is a procedure for users to access private data as follows: {{ personaldatamanagedaccessreply }}{% endtrans %}</p>
                {%- endif -%}
            {%- endif -%}
        {%- endif -%}

    </div>
</div>