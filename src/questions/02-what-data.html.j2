{#- data -#}
{%- set measured = x.creatingData.hasMeasuredData -%}
{%- set nonMeasured = x.creatingData.hasNonMeasuredData -%}
{%- set producedDatasets = x.preservingData.producedDatasets -%}
{%- set preexisting = x.reusingData.hasPreExistingData -%}
{%- set formats = x.creatingData.usesDataFormats -%}

<div id="q-what-data" class="question">
  <h3>{% trans %}2. What data (kind, format, volume) will be collected or produced?{% endtrans %}</h3>
  <div class="answer">

  {%- if measured._value is true -%}
    {%- set datasets = measured.datasets -%}
    {# Measured datasets #}
    {%- if datasets|length > 0 -%}
      <div>
      <h4>{% trans %}Instrument datasets{% endtrans %}</h4>
      <p>{% trans %}The following instrument datasets will be acquired in the project:{% endtrans %}</p>
      <ul class="entries">
        {%- for dataset in datasets -%}
          <li>
            {%- set datasetName = dataset.dataset._value -%}
            {%- set whoWhere = dataset.whoWhere -%}
            {%- set equipment = dataset.isStandardAndWellDescribed._value -%}
            <strong>{{ datasetName if datasetName else _("(no name given)") }}</strong>
            {# Who will collect #}
            {%- if whoWhere._value == 'expertsOwn' -%}
              <p>{% trans %}This dataset will be collected by experts in the project, with our own equipment.{% endtrans %}</p>
            {%- elif whoWhere._value == 'expertsSpecialised' -%}
              <p>{% trans %}This dataset will be collected by experts in the project, at a specialized infrastructure.{% endtrans %}</p>
            {%- elif whoWhere._value == 'external' -%}
              {%- set ownership = whoWhere.ownership -%}
              {% call macros.para() %}
                {% trans %}This dataset will be collected by an external party.{% endtrans %}
                {% if ownership._value == 'external' -%}
                  {% trans %}The ownership of the resulting data will remain with the external party.{% endtrans %}
                {%- elif ownership._value == 'projectPartners' -%}
                  {% trans %}The project partners acquire full ownership of the data.{% endtrans %}
                {%- elif ownership._value == 'other' -%}
                  {%- set ownershipOther = ownership.other._value -%}
                  {%- if ownershipOther -%}
                    {% trans value=(macros.md(ownershipOther)) %}For the ownership of the data we have made the following arrangements: {{ value }}{% endtrans %}
                  {%- endif -%}
                {%- endif -%}
              {% endcall %}
            {%- endif -%}
            {# Equipment standard? #}
            {% if equipment is true -%}
              <p>{% trans %}The equipment is very well described and known.{% endtrans %}</p>
            {%- elif equipment is false -%}
              <p>{% trans %}The equipment is less well described or not completely standard, so we will need to take extra care documenting the process.{% endtrans %}</p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
      </div>
    {%- endif -%}
  {%- endif -%}

  {# Non-equipment datasets #}
  {%- if nonMeasured._value is true -%}
    {%- set neqDatasets = nonMeasured.datasets -%}

    {%- set questionnaires = nonMeasured.questionnaires._value is true -%}
    {%- set caseReport = nonMeasured.caseReportForms._value is true -%}
    {%- set eRecords = nonMeasured.patientRecords._value is true -%}
    {%- if questionnaires or caseReport or eRecords or neqDatasets|length > 0 -%}
      <div>
      <h4>{% trans %}Non-equipment datasets{% endtrans %}</h4>
      {# Types #}
      {%- set typesNames = [] -%}
      {%- if questionnaires -%}{%- do typesNames.append(_("questionnaires")) -%}{%- endif -%}
      {%- if caseReport -%}{%- do typesNames.append(_("case report forms")) -%}{%- endif -%}
      {%- if eRecords -%}{%- do typesNames.append(_("electronic patient records")) -%}{%- endif -%}
      {%- set typesCount = typesNames|length -%}
      {% call macros.para() %}
        {%- if typesCount > 0 -%}
          {% trans %}We collect data from{% endtrans %}
          {% if typesCount == 1 -%}
              {{ typesNames[0] }}.
          {%- elif typesCount == 2 -%}
              {#- TRANSLATORS: completes "We collect data from"; the sources are "questionnaires" etc. -#}
              {% trans source=(typesNames[0]), source2=(typesNames[1]) %}{{ source }} and {{ source2 }}.{% endtrans %}
          {%- else -%}
              {% trans source=(typesNames[0]), source2=(typesNames[1]), source3=(typesNames[2]) %}{{ source }}, {{ source2 }}, and {{ source3 }}.{% endtrans %}
          {%- endif -%}
        {% endif %}
        {# Datasets #}
        {%- if neqDatasets|length > 0 -%}
          {% trans %}The non-equipment datasets are:{% endtrans %}
          <ul class="entries">
          {%- for neqDataset in neqDatasets -%}
            {%- set neqDatasetName = neqDataset.dataset._value -%}
            {%- set neqDatasetDesc = neqDataset.description._value -%}
            <li>
              <strong>{{ neqDatasetName if neqDatasetName else _("(no name given)") }}</strong>
              {% if neqDatasetDesc -%}<span class="separator">&ndash;</span> {{ macros.md(neqDatasetDesc) }}{%- endif -%}
            </li>
          {%- endfor -%}
          </ul>
        {%- endif -%}
      {% endcall %}
      </div>
    {%- endif -%}
  {%- endif -%}
  {# Produced datasets #}
  {%- if producedDatasets|length > 0 -%}
    <div>
    <h4>{% trans %}Produced datasets{% endtrans %}</h4>
    <p>{% trans %}The project will produce the following datasets:{% endtrans %}</p>
    <ul class="entries">
    {%- for produced in producedDatasets -%}
      {%- set producedName = produced.dataset._value -%}
      {%- set producedDesc = produced.description._value -%}
      {%- set published = produced.published._value -%}
      <li>
        <strong>{{ producedName if producedName else _("(no name given)") }}</strong>
        {%- if published is false %}
        <span class="status">{% trans %}(not published){% endtrans %}</span>
        {%- elif published is true %}
        <span class="status">{% trans %}(will be published){% endtrans %}</span>
        {%- endif -%}
        {%- if producedDesc %}
        {% call macros.para() %}{{ macros.md(producedDesc) }}{% endcall %}
        {%- endif %}
      </li>
    {%- endfor -%}
    </ul>
    </div>
  {%- endif -%}
  {# Existing datasets #}
  {%- if preexisting._value is true -%}
    {%- if (preexisting.referenceDatasets|length + preexisting.nonReferenceDatasets|length) > 0 -%}
      <div>
        <h4>{% trans %}Re-used datasets{% endtrans %}</h4>
        <p>{% trans %}Datasets considered for reuse and actually reused are described in Question 1.{% endtrans %}</p>
      </div>
    {%- endif -%}
  {%- endif -%}

  {# Format/Type with volume #}
  {%- if formats|length > 0 -%}
    <h4>{% trans %}Data formats and types{% endtrans %}</h4>
    <div><p>{% trans %}We will be using the following data formats and types:{% endtrans %}</p>
    <ul class="entries">
      {%- for format in formats -%}
        {%- set isStandard = format.isStandard -%}
        {%- set ltSuitable = format.enablesSharingArchiving -%}
        {%- set volume = format.volume -%}
        <li>
          {# identification #}
          <strong>{{ macros.fairsharing(format.format) }}</strong>
          {%- if isStandard._value is not none or ltSuitable._value is not none or volume._value is not none -%}
            <p>
            {# standard? #}
            {%- if isStandard._value is true %}
              {% trans %}It is a standardized format.{% endtrans %}
            {%- elif isStandard._value is false -%}
              {%- set whyNonStandard = isStandard.reason -%}
              {%- if whyNonStandard._value == 'noStandard' %}
                {% trans %}We are not using a standardized format because there is no standardized format for this data type.{% endtrans %}
              {%- elif whyNonStandard._value == 'optimized' %}
                {% trans %}We are not using a standardized format but it is optimized for processing speed and/or volume.{% endtrans %}
              {%- elif whyNonStandard._value == 'other' -%}
                {%- set otherReason = whyNonStandard.reason._value -%}
                {% trans %}We are not using a standardized format{% endtrans %}
                {%- if otherReason -%}
                  {% trans value=(otherReason[:1]|upper ~ otherReason[1:]) %}, because: {{ value }}{% endtrans %}
                {%- endif -%}
                .
              {%- endif -%}
            {%- endif -%}
            {# long-term suitable? #}
            {%- if ltSuitable._value is true %}
              {% trans %}This is a suitable format for long-term archiving.{% endtrans %}
            {%- elif ltSuitable._value is false -%}
              {%- set convert = ltSuitable.convert._value -%}
              {%- if convert is true %}
                {% trans %}This is not a suitable format for long-term archiving; however, we plan to convert it to a suitable format before the end of the project.{% endtrans %}
              {%- elif convert is false %}
                {% trans %}We are aware that this is not a suitable format for long-term archiving.{% endtrans %}
              {%- endif -%}
            {%- endif -%}
            {# volume #}
            {%- if volume._value == 'small' %}
              {% trans %}We will have only a small amount of data stored in this format.{% endtrans %}
            {%- elif volume._value == 'gigabytes' -%}
              {%- set volumeTotalGB = volume.valueGb._value -%}
              {%- if volumeTotalGB not in [none, ''] %}
                {% trans formatsvolumetotalgb=volumeTotalGB %}We expect to have {{ formatsvolumetotalgb }} GB of data in this format.{% endtrans %}
              {%- endif -%}
            {%- elif volume._value == 'files' -%}
              {%- set volumeFiles = volume.number._value -%}
              {%- set volumeFileGB = volume.averageSizeGb._value -%}
              {%- if volumeFiles not in [none, ''] and volumeFileGB not in [none, ''] %}
                {% trans formatsvolumefiles=volumeFiles, formatsvolumefilegb=volumeFileGB, total=((volumeFiles|int * volumeFileGB|float)|round(2)) %}We expect to have {{ formatsvolumefiles }} files of average size {{ formatsvolumefilegb }} GB (i.e. approximately {{ total }} GB in total).{% endtrans %}
              {%- endif -%}
            {%- endif -%}
            </p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
    </div>
  {%- endif -%}
  </div>
</div>
