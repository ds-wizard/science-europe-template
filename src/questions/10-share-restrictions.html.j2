{#- data -#}
{%- set datasets = x.preservingData.producedDatasets -%}
{%- set openOverTime = x.givingAccessToData.allOpenOverTime -%}
{%- set embargo = x.givingAccessToData.useEmbargo -%}
{%- set authenticatedAccess = openOverTime.legalReasons.authenticatedAccess -%}
{%- set collab = x.creatingData.withDifferentGroups -%}

<div id="q-share-restrictions" class="question">
  <h3>{% trans %}10. How and when will data be shared? Are there possible restrictions to data sharing or embargo reasons?{% endtrans %}</h3>

  <div class="answer">
    {# How data will be shared #}
    {# Produced datasets #}
    <h4>{% trans %}How the data will be shared{% endtrans %}</h4>
    {%- if datasets|length > 0 -%}
        <ul class="entries">
        {%- for dataset in datasets -%}
            {%- set producedDataName = dataset.dataset._value -%}
            {%- set published = dataset.published -%}
            <li>
            <strong>{{ producedDataName if producedDataName else _("(no name given)") }}</strong>
            {# If will be published #}
            {% if published._value is false %}
                <span class="status">{% trans %}(not published){% endtrans %}</span>
            {% elif published._value is true %}
                <span class="status">{% trans %}(will be published){% endtrans %}</span>
                {# Identifiers #}
                {% if dataset.identifiers|length > 0 -%}
                    <p>{% trans %}The dataset has the following identifiers:{% endtrans %}</p>
                    <ul>
                    {%- for identifier in dataset.identifiers if identifier.identifier._value -%}
                        {%- set identifierValue = identifier.identifier._value -%}
                        {%- set identifierType = macros.fairsharingLabel(identifier.type)|trim -%}
                        {%- if identifierType|upper == 'DOI' -%}
                            <li>{% trans %}DOI:{% endtrans %} <strong><a href="https://doi.org/{{ identifierValue }}" target="_blank">{{ identifierValue }}</a></strong></li>
                        {%- elif identifierValue.startswith('http://') or identifierValue.startswith('https://') -%}
                            <li>{{ identifierType ~ ': ' if identifierType }}<strong><a href="{{ identifierValue }}" target="_blank">{{ identifierValue }}</a></strong></li>
                        {%- else -%}
                            <li>{{ identifierType ~ ': ' if identifierType }}<strong>{{ identifierValue }}</strong></li>
                        {%- endif -%}
                    {%- endfor -%}
                    </ul>
                {%- endif -%}
                {# Distributions #}
                {% if published.distributions|length > 0 -%}
                    <p>{% trans %}The distributions will be available as follows:{% endtrans %}</p>
                    <ul>
                    {%- for distro in published.distributions -%}
                        {%- set repository = distro.repository -%}
                        {%- set repositoryKind = repository._value -%}
                        {%- set distroAccess = distro.access._value -%}
                        <li>
                        {%- if repositoryKind is not none or distroAccess is not none -%}
                            {%- if distroAccess == 'open' %}
                                {% trans %}Open (shared with anyone){% endtrans %}
                            {%- elif distroAccess == 'shared' %}
                                {% trans %}Shared with a predefined list of people{% endtrans %}
                            {%- elif distroAccess == 'closed' %}
                                {% trans %}Closed (not meant for sharing){% endtrans %}
                            {%- else %}
                                {#- TRANSLATORS: followed by "using a ... repository" when the sharing level is not given -#}
                                {% trans %}Distribution{% endtrans %}
                            {%- endif %}
                            {% if repositoryKind == 'domainSpecific' %}
                                {% trans %}using a domain-specific repository{% endtrans %}
                                {%- if repository.repository._value is not none -%}
                                : {{ macros.fairsharing(repository.repository) }}.
                                {%- else -%}.
                                {% endif -%}
                                {# Contact the repository #}
                                {%- set contactBefore = repository.contactBefore._value -%}
                                {%- if contactBefore == 'no' %}
                                {% trans %}We don't need to contact the repository because it is a routine for us.{% endtrans %}
                                {%- elif contactBefore == 'done' %}
                                {% trans %}We have already contacted the repository.{% endtrans %}
                                {%- elif contactBefore == 'will' %}
                                {% trans %}We are going to contact the repository.{% endtrans %}
                                {%- elif contactBefore == 'other' %}
                                {%- set domainSpecificRepoContactBeforeOther = repository.contactBefore.other._value %}
                                {#- TRANSLATORS: %(details)s is ": " followed by the user's text, or just "." #}
                                {% trans details=(": " ~ macros.md(domainSpecificRepoContactBeforeOther) if domainSpecificRepoContactBeforeOther else ".") %}We have made other arrangements{{ details }}{% endtrans %}
                                {%- endif -%}
                            {%- elif repositoryKind == 'generalPurpose' %}
                                {% trans %}using a general-purpose repository{% endtrans %}
                                {%- if repository.repository._value is not none -%}
                                    : {{ macros.fairsharing(repository.repository) }}.
                                {%- else -%}.
                                {%- endif -%}
                            {%- elif repositoryKind == 'national' %}
                                {% trans %}using our national repository.{% endtrans %}
                            {%- elif repositoryKind == 'institutional' %}
                                {% trans %}using our institutional repository.{% endtrans %}
                            {%- elif repositoryKind == 'specialPurpose' %}
                                {% trans %}using a special-purpose repository for the project.{% endtrans %}
                            {%- endif -%}
                        {%- endif -%}
                        {# Licenses #}
                        {%- set licensesItems = distro.licenses -%}
                        {%- if licensesItems|length > 0 %}
                            <p class="lead">{% trans count=[licensesItems|length, 1]|max %}The distribution will be available under the following license:{% pluralize %}The distribution will be available under the following licenses:{% endtrans %}</p>
                            <ul>
                            {%- for licenseItem in licensesItems -%}
                                <li>
                                {%- set licenseStart = licenseItem.startDate._value -%}
                                {% if licenseStart %}
                                    {% trans licensestart=licenseStart %}Starting {{ licensestart }}:{% endtrans %} 
                                {% endif %}
                                
                                {%- set license = licenseItem.license -%}
                                {%- if license._value == 'freeOpen' %}
                                    {% trans %}Freely available for any use (public domain or CC0).{% endtrans %}
                                {%- elif license._value == 'freeOpenAttribution' %}
                                    {% trans %}Freely available with obligation to quote the source (e.g. CC-BY).{% endtrans %}
                                {%- elif license._value == 'restrictions' -%}
                                    {%- set licenseRestrictConditions = license.conditions._value -%}
                                    {%- set licenseRestrictLink = license.licenseUrl._value -%}
                                    {%- set accessReusers = license.accessReusers._value %}
                                    
                                    {#- TRANSLATORS: %(details)s is ": " followed by the user's text, or just "." -#}
                                    {% trans details=(": " ~ macros.md(licenseRestrictConditions) if licenseRestrictConditions else ".") %}Available under some restrictions, which we will follow in our project{{ details }}{% endtrans %}
                                    {%- if accessReusers == 'contactPerson' %}
                                    {% trans %}Re-users will be able to get access by request to the contact person.{% endtrans %}
                                    {%- elif accessReusers == 'committee' %}
                                    {% trans %}Re-users will be able to get access through a <em>Data Access Committee</em> for the project.{% endtrans %}
                                    {%- elif accessReusers == 'other' -%}
                                    {%- set licenseRestrictAccessAnother = license.accessReusers.other._value %}
                                    {# TRANSLATORS: %(details)s is ": " followed by the user's text, or just "." -#}
                                    {% trans details=(": " ~ macros.md(licenseRestrictAccessAnother) if licenseRestrictAccessAnother else ".") %}Re-users will be able to get access through a specialized process{{ details }}{% endtrans %}
                                    {%- endif -%}
                                    {%- if license.inMetadata._value is true %}
                                    {% trans %}The conditions will be published as part of open metadata.{% endtrans %}
                                    {%- endif -%}
                                    {% if licenseRestrictLink %}
                                    {% trans %}More information about the restrictions can be found here:{% endtrans %} <a href="{{ licenseRestrictLink }}" target="_blank">{{ licenseRestrictLink }}</a>.
                                    {% endif %}
                                {%- endif -%}
                                </li>
                            {%- endfor -%}
                            </ul>
                        {%- endif -%}
                        </li>
                    {%- endfor -%}
                    </ul>
                {%- endif -%}
            {%- endif -%}
            {# Catalogue #}
            {%- if published.addingCatalogReference._value == 'yes' -%}
                <p>{% trans %}We will be adding a reference to the published data to at least one data catalogue.{% endtrans %}</p>
            {%- endif -%}
            {# When published #}
            {%- set publishedWhen = published.when._value -%}
            {%- if publishedWhen == 'afterCollecting' %}
                <p>{% trans %}The dataset will be published as soon as possible after collecting it.{% endtrans %}</p>
            {%- elif publishedWhen == 'afterCleanup' %}
                <p>{% trans %}The dataset will be published after initial cleanup.{% endtrans %}</p>
            {%- elif publishedWhen == 'afterProcessing' %}
                <p>{% trans %}The dataset will be published after all our processing has finished.{% endtrans %}</p>
            {%- elif publishedWhen == 'afterProject' %}
                <p>{% trans %}The dataset will be published when the project is wrapped up.{% endtrans %}</p>
            {%- elif publishedWhen == 'afterEmbargo' %}
                <p>{% trans %}The dataset will be published after an embargo.{% endtrans %}</p>
            {%- endif %}
            {# Qualified references #}
            {%- if published.qualifiedReferences._value is true -%}
                {%- set qreferences = [] -%}
                {%- for item in published.qualifiedReferences.references -%}
                    {%- set refId = (item.identifier._value or '')|e -%}
                    {%- set refRel = (item.relationship._value or '')|e -%}
                    {%- if refId and refRel -%}
                    {%- do qreferences.append({
                        'id': refId,
                        'relation': refRel,
                    }) -%}
                    {%- endif -%}
                {%- endfor -%}
            {%- endif -%}
            {%- if qreferences|length > 0 -%}
                <p>{% trans %}The following qualified references to other data sets will be included:{% endtrans %}</p>
                <ul>
                    {%- for qref in qreferences -%}
                    <li><em>{{ qref.id|e }}</em> &ndash; {{ macros.md(qref.relation) }}</li>
                    {%- endfor -%}
                </ul>
            {%- endif -%}
            </li>
        {%- endfor -%}
        </ul>
    {%- endif -%}

    {# Restrictions #}

    <h4>{% trans %}Restrictions on data sharing{% endtrans %}</h4>
    <p>{% trans service_name=dc.config.service_name %}Ethical and legal restrictions are documented under Section 4. We have used the {{ service_name }}, which made us aware of options to minimize the restrictions.{% endtrans %}</p>

    {%- if openOverTime._value is true -%}
      <p>{% trans %}No data sharing agreement will be required.{% endtrans %}</p>
    {%- elif openOverTime._value is false -%}
      {%- if embargo._value == 'yesEmbargo' -%}
        {%- set embargoPeriod = embargo.period._value -%}
        <p>
          {% trans %}Data cannot be completely open due to legal reasons. However, data that is not legally restricted will be released after a fixed time period.{% endtrans %}
          {%- if embargoPeriod %}
            {% trans value=(embargoPeriod|trim|dot) %}The embargo period will be {{ value }}{% endtrans %}
          {%- endif %}
        </p>
      {%- endif -%}

      {%- if authenticatedAccess._value is true -%}
        <p>
          {% trans %}A data sharing agreement will be required.{% endtrans %}
          {%- set authorisation = authenticatedAccess.authorisation -%}
          {%- if authorisation._value == 'member' %}
            {% trans %}People can apply to one of the project members.{% endtrans %}
          {%- elif authorisation._value == 'committee' %}
            {% trans %}People can apply to the data access committee that we will set up.{% endtrans %}
          {%- elif authorisation._value == 'existingCommittee' %}
            {%- set legalReasonsAuthorizeOldCommittee = authorisation.committee._value -%}
            {%- if legalReasonsAuthorizeOldCommittee %}
              {% trans value=(macros.md(legalReasonsAuthorizeOldCommittee)) %}People can apply to the following data access committee: <em>{{ value }}</em>{% endtrans %}
            {%- else -%}
              {% trans %}People can apply to an existing data access committee.{% endtrans %}
            {%- endif -%}
          {%- elif authorisation._value == 'other' %}
            {%- set legalReasonsAuthorizeOther = authorisation.other._value %}
            {#- TRANSLATORS: %(details)s is ": " followed by the user's text, or just "." -#}
            {% trans details=(": " ~ macros.md(legalReasonsAuthorizeOther) if legalReasonsAuthorizeOther else ".") %}For the authorization of potential users, we will make special arrangements{{ details }}{% endtrans %}
          {%- endif -%}
        </p>
      {%- endif -%}
    {%- endif -%}

    {%- if collab._value is false -%}
      <p>{% trans %}We are not running the project in a collaboration between different groups or institutes. Therefore, no collaboration agreement related to data access is needed.{% endtrans %}</p>
    {%- elif collab._value is true -%}
      {%- if collab.hasAgreement._value is false -%}
        <p>{% trans %}We are running the project in a collaboration between different groups and institutes. However, there is no collaboration agreement in the project that describes who can have access to what data.{% endtrans %}</p>
      {%- elif collab.hasAgreement._value is true -%}
        <p>{% trans %}We are running the project in a collaboration between different groups and institutes. A collaboration agreement that describes who can have access to what data in the project is in place.{% endtrans %}</p>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>
