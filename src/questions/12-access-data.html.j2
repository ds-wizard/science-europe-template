{#- data -#}
{%- set datasets = x.preservingData.producedDatasets -%}

<div id="q-dm-responsible" class="question">
  <h3>{% trans %}12. What methods or software tools are needed to access and use data?{% endtrans %}</h3>

  <div class="answer">
    {# Produced datasets #}
    {%- if datasets|length > 0 -%}
        <ul class="entries">
        {%- for dataset in datasets -%}
            {%- set producedDataName = dataset.dataset._value -%}
            {%- set published = dataset.published -%}
            <li>
            {# If will be published #}
            {% if published._value is true %}
                {# If SW is required #}
                {%- set softwareNeeded = published.specificSoftwareNeeded -%}
                <strong>{{ producedDataName if producedDataName else _("(no name given)") }}</strong>
                {%- if softwareNeeded._value is true -%}
                    {%- set softwareItems = softwareNeeded.software -%}
                    {%- if softwareItems|length > 0 -%}
                            <br>{% trans %}In order to use this dataset, the following software will be needed:{% endtrans %}
                            <ul class="software">
                            {%- for software in softwareItems -%}
                                {%- set swNameReply = software.name._value -%}
                                {%- set swPIDReply = software.pid._value -%}
                                <li><strong>{{ swNameReply if swNameReply else _("(no name given)") }}</strong>
                                {%- if swPIDReply -%}
                                {% trans value=(macros.md(swPIDReply|trim|dot)) %}, available at {{ value }}{% endtrans %}
                                {%- else -%}
                                .
                                {%- endif -%}</li>
                            {%- endfor -%}
                            </ul>
                    {%- else -%}
                        <p>{% trans %}There are no tools needed to access or use this data.{% endtrans %}</p>
                    {%- endif -%}
                {%- else -%}
                    <p>{% trans %}There are no tools needed to access or use this data.{% endtrans %}</p>
                {%- endif -%}
            {%- else -%}
                <strong>{{ producedDataName if producedDataName else _("(no name given)") }}</strong> <span class="status">{% trans %}(not published){% endtrans %}</span>
            {%- endif -%}
            </li>
        {%- endfor -%}
    {%- else -%}
        <p>{% trans %}There are no published data to access or use.{% endtrans %}</p>
    {%- endif -%}
  </div>
</div>
