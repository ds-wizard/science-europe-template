{#- data -#}
{%- set workspace = x.processingData.sharedWorkingSpace -%}
{%- set reliability = workspace.reliability -%}

<div id="q-store-backup" class="question">
  <h3>{% trans %}5. How will data and metadata be stored and backed up during the research?{% endtrans %}</h3>

  <div class="answer">
    {# Data stored by members (no shared workspace) #}
    {%- if workspace._value is false -%}
      <p>{% trans %}There is no shared workspace used during the project for working with data.{% endtrans %}</p>
      {%- if workspace.backupTraceable._value is true -%}
        <p>{% trans %}Data that project members themselves store are adequately backed up and traceable. Therefore data are protected against both equipment failure and human error.{% endtrans %}</p>
      {%- endif -%}
    {%- elif workspace._value is true -%}
      <p>{% trans %}There is a shared workspace used during the project for working with data.{% endtrans %}</p>
      {%- if workspace.workWithData._value == 'explore' -%}
        {%- set change = workspace.workWithData.storageChangeNeeds._value -%}
        {%- if change == 'same' -%}
          <p>{% trans %}Storage needs will be the same during the whole project.{% endtrans %}</p>
        {%- elif change == 'largeReduce' -%}
          <p>{% trans %}Storage needs are large at the beginning and will be reduced later.{% endtrans %}</p>
        {%- elif change == 'smallGrow' -%}
          <p>{% trans %}Storage needs are small at the beginning and will grow later.{% endtrans %}</p>
        {%- elif change == 'largestMiddle' -%}
          <p>{% trans %}Storage needs are largest in the middle of the project.{% endtrans %}</p>
        {%- endif -%}
      {%- endif -%}
      {%- if reliability._value == 'explore' -%}
        {%- set preventLoss = reliability.dataLossPrevention._value -%}
        {%- set backup = reliability.otherBackup._value -%}
        {%- if preventLoss or backup -%}
          <p>
          {%- if preventLoss == 'sufficient' %}
            {% trans %}The work space provides sufficient guarantees in terms of preventing a total loss of data.{% endtrans %}
          {%- elif preventLoss == 'duplication' %}
            {% trans %}All essential data is also stored elsewhere to prevent a total loss of data.{% endtrans %}
          {%- endif -%}
          {%- if backup == 'projectParticipants' %}
            {% trans %}Backup of project data that is not in the work space is left to the project participants.{% endtrans %}
          {%- elif backup == 'noDataElsewhere' %}
            {% trans %}Data is stored only in the work space, therefore additional backup copies of files outside work space are necessary.{% endtrans %}</p>
          {%- elif backup == 'allBackedUp' %}
            {% trans %}All project data stored outside of the working area will be adequately backed up.{% endtrans %}
          {%- elif backup == 'automatedBackups' %}
            {% trans %}We will make (automated) backups of all data stored outside of the working area.{% endtrans %}
          {%- endif -%}
          </p>
        {%- endif -%}
      {%- endif -%}
    {%- endif -%}
  </div>

</div>
