{#- data -#}
{%- set preserving = x.preservingData -%}
{%- set datasets = preserving.producedDatasets -%}
{%- set fees = preserving.repositoryFees -%}

<div id="q-data-preservation" class="question">
  <h3>{% trans %}11. How will data for preservation be selected, and where data will be preserved long-term (for example a data repository or archive)?{% endtrans %}</h3>

  <div class="answer">
    {# Produced datasets #}
    {%- if datasets|length > 0 -%}
      <p>
      {% trans %}We plan to produce the following datasets:{% endtrans %}
      <ul class="entries">
      {%- for dataset in datasets -%}
        {%- set producedDataName = dataset.dataset._value -%}
        {%- set published = dataset.published -%}
        {%- set retention = dataset.retention -%}
        {%- set metadataPersistent = dataset.persistentMetadata._value is true -%}
        <li>
          <strong>{{ producedDataName if producedDataName else _("(no name given)") }}</strong>
          {# If will be published #}
          {% if published._value is false %}
            <span class="status">{% trans %}(not published){% endtrans %}</span>
          {% elif published._value is true %}
            <span class="status">{% trans %}(will be published){% endtrans %}</span>
          {% endif -%}
          {# How long will be stored + Metadata FAIRness #}
          {%- if retention._value or metadataPersistent %}
            {% if retention._value == 'asLongAsPossible' -%}
              <p>{% trans %}This data set will be kept available as long as technically possible.{% endtrans %}</p>
            {%- elif retention._value == 'untilDelete' -%}
              <p> {% trans %}This data set will be kept available until it needs to be deleted for legal, contractual or regulatory reasons.{% endtrans %}</p>
            {%- elif retention._value == 'fixedPeriod' -%}
              {%- set publishedDataHowLongFixed = retention.period._value -%}
              {#- TRANSLATORS: %(details)s is ": " followed by the user's text, or just "." -#}
              <p>{% trans details=(": " ~ publishedDataHowLongFixed|trim|dot if publishedDataHowLongFixed else ".") %}This data set will be kept available for a fixed period (prepaid){{ details }}{% endtrans %}</p>
            {%- endif -%}
            {%- if metadataPersistent %}
              <p>{% trans %}The metadata will be available even when the data no longer exists.{% endtrans %}</p>
            {%- endif -%}
          {%- endif -%}

           {# Distributions #}
          {% set distributions = published.distributions -%}
          {%- if distributions|length > 0 -%}
            <p>{% trans %}The distributions will be stored in:{% endtrans %}</p>
            <ul>
            {%- for distribution in distributions -%}
              {%- set repository = distribution.repository -%}
              {%- set repositoryKind = repository._value -%}
              {%- if repositoryKind -%}
                <li>
                  {%- if repositoryKind == 'domainSpecific' %}
                    {% trans %}Domain-specific repository{% endtrans %}
                    {%- if repository.repository._value is not none -%}
                      : {{ macros.fairsharing(repository.repository) }}.
                    {%- else -%}.
                    {% endif -%}
                    {# Contact the repository #}
                    {%- set contactBefore = repository.contactBefore -%}
                    {%- if contactBefore._value == 'no' %}
                      {% trans %}We don't need to contact the repository because it is a routine for us.{% endtrans %}
                    {%- elif contactBefore._value == 'done' %}
                      {% trans %}We have already contacted the repository.{% endtrans %}
                    {%- elif contactBefore._value == 'will' %}
                      {% trans %}We are going to contact the repository.{% endtrans %}
                    {%- elif contactBefore._value == 'other' %}
                      {%- set domainSpecificRepoContactBeforeOther = contactBefore.other._value %}
                      {#- TRANSLATORS: %(details)s is ": " followed by the user's text, or just "." #}
                      {% trans details=(": " ~ macros.md(domainSpecificRepoContactBeforeOther) if domainSpecificRepoContactBeforeOther else ".") %}We have made other arrangements instead of contacting the repository directly{{ details }}{% endtrans %}
                    {%- endif -%}
                  {%- elif repositoryKind == 'generalPurpose' %}
                    <em>{% trans %}General-purpose repository{% endtrans %}</em>
                    {%- if repository.repository._value is not none -%}
                      : {{ macros.fairsharing(repository.repository) }}.
                    {%- else -%}.
                    {% endif -%}
                  {%- elif repositoryKind == 'national' %}
                    {% trans %}Our national repository.{% endtrans %}
                  {%- elif repositoryKind == 'institutional' %}
                    {% trans %}Our institutional repository.{% endtrans %}
                  {%- elif repositoryKind == 'specialPurpose' %}
                    {% trans %}Special-purpose repository for the project.{% endtrans %}
                    {# Long-term support #}
                    {%- if repository.longTermSupport._value is true %}
                      {% trans %}We will be able to support this repository for a sufficiently long time.{% endtrans %}
                    {%- endif -%}
                    {# Service level #}
                    {%- set serviceLevel = repository.serviceLevel._value -%}
                    {%- if serviceLevel == 'onlyDownload' %}
                      {% trans %}The repository will provide a download-only service.{% endtrans %}
                    {%- elif serviceLevel == 'simpleSearch' %}
                      {% trans %}The repository will provide a search and simple access interface.{% endtrans %}
                    {%- elif serviceLevel == 'advanced' %}
                      {% trans %}The repository will provide an advanced processing service.{% endtrans %}
                    {%- endif -%}
                  {%- endif -%}
                </li>
              {%- endif -%}
            {%- endfor -%}
            </ul>
          {%- endif -%}
          {# Catalogue #}
          {%- if published.addingCatalogReference._value == 'yes' -%}
            <p>{% trans %}We will be adding a reference to the published data to at least one data catalogue.{% endtrans %}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
      </ul>
    {# Repository charges #}
    {%- if fees._value is false -%}
      <p>{% trans %}None of the used repositories charge for their services.{% endtrans %}</p>
    {%- elif fees._value is true -%}
      {%- set paying = fees.paying._value -%}
      {%- if paying == 'budget' -%}
        <p>{% trans %}We have budgeted for the costs in the project to pay charges of the used repositories.{% endtrans %}</p>
      {%- elif paying == 'department' -%}
        <p>{% trans %}The costs related to the used repositories will be carried by (one of) the departments involved in the project.{% endtrans %}</p>
      {%- elif paying == 'institute' -%}
        <p>{% trans %}The costs related to the used repositories will be carried by (one of) the institutes involved in the project.{% endtrans %}</p>
      {%- elif paying == 'other' -%}
        {%- set repoChargesHowPayOther = fees.paying.other._value -%}
        {%- if repoChargesHowPayOther -%}
          <p>{% trans value=(macros.md(repoChargesHowPayOther)) %}We will carry the costs related to the used repositories by: {{ value }}{% endtrans %}</p>
        {%- endif -%}
      {%- endif -%}
    {%- endif -%}
    {# Budget time and effort #}
    {%- if preserving.hasDataPublicationBudget._value is true -%}
      <p>{% trans %}We have a reserved budget for the time and effort it will take to prepare the data for publication.{% endtrans %}</p>
    {%- endif -%}
  {%- endif -%}
  </div>
</div>