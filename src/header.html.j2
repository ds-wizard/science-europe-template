{#- data -#}
{%- set contributors = x.administrativeInformation.contributors -%}
{%- set contacts = [] -%}
{%- set creators = [] -%}
{%- for contributor in contributors -%}
  {%- set roles = contributor.roles|map(attribute='_value')|list -%}
  {%- if 'contactPerson' in roles -%}{%- do contacts.append(contributor) -%}{%- endif -%}
  {%- if 'creatorOfDmp' in roles -%}{%- do creators.append(contributor) -%}{%- endif -%}
{%- endfor -%}

<header>
  <p class="doc-type">{% trans %}Data Management Plan{% endtrans %}</p>
  <h1>{{ dc.project.name }}</h1>
  <p class="guidance">{% trans %}Structured according to the Science Europe core requirements for data management plans{% endtrans %}</p>
  <div class="dmp-info">
    <dl>
      {%- if contributors|length > 0 -%}
        {%- set nContacts = contacts|length -%}
        <dt>{% trans count=[nContacts, 1]|max %}Contact person{% pluralize %}Contact people{% endtrans %}</dt>
        <dd>
          {%- if nContacts > 0 -%}
            <ul>
              {%- for person in contacts -%}
                <li>
                  {%- set contributorName = person.name._value -%}
                  {%- set contributorEmail = person.email._value -%}
                  {%- set contributorOrcid = person.orcid if person.orcid._value is not none else none -%}
                  {%- set contributorAffiliationReply = person.affiliation if person.affiliation._value is not none else none -%}

                  {%- if contributorName -%}
                    <span class="contact-name">{{ contributorName }}</span>
                  {%- else -%}
                    <span class="contact-name missing">{% trans %}(name not given){% endtrans %}</span>
                  {%- endif -%}
                  {%- if contributorEmail and contributorOrcid %}
                    <br>{{ macros.formatEmail(contributorEmail) }}, {{ macros.orcid(contributorOrcid) }}
                  {%- elif contributorEmail %}
                    <br>{{ macros.formatEmail(contributorEmail) }}
                  {%- elif contributorOrcid %}
                    <br>{{ macros.orcid(contributorOrcid) }}
                  {%- endif -%}
                  {%- if contributorAffiliationReply %}
                    <br>{{ macros.ror(contributorAffiliationReply) }}
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          {%- else -%}
            <span class="empty-value">{% trans %}There is no contact person specified yet{% endtrans %}</span>
          {%- endif -%}
        </dd>
      {%- endif -%}

      {%- if dc.km_package %}
      <dt>{% trans %}Based on{% endtrans %}</dt>
      <dd>{{ dc.km_package.name }}, {{ dc.km_package.version }} (<span class="package-id">{{ dc.km_package.id }}:{{ dc.km_package.version }}</span>)</dd>
      {%- endif -%}

      {%- if dc.questionnaire.phase_uuid -%}
      <dt>{% trans %}Project phase{% endtrans %}</dt>
      <dd>{{ dc.questionnaire.phase.title }}</dd>
      {%- endif -%}

      {%- set nCreators = creators|length -%}
      <dt>{% trans %}Created by{% endtrans %}</dt>
        <dd>
          {%- if nCreators > 0 -%}
            <ul>
                {%- for person in creators -%}
                  <li>
                    {%- set creatorName = person.name._value -%}
                    {%- set creatorEmail = person.email._value -%}
                    {%- set creatorOrcid = person.orcid if person.orcid._value is not none else none -%}
                    {%- set creatorAffiliationReply = person.affiliation if person.affiliation._value is not none else none -%}

                    {%- if creatorName -%}
                      <span class="contact-name">{{ creatorName }}</span>
                    {%- else -%}
                      <span class="contact-name missing">{% trans %}(name not given){% endtrans %}</span>
                    {%- endif -%}
                    {%- if creatorEmail and creatorOrcid -%}
                      <br>{{ macros.formatEmail(creatorEmail) }}, {{ macros.orcid(creatorOrcid) }}
                    {%- elif creatorEmail -%}
                      <br>{{ macros.formatEmail(creatorEmail) }}
                    {%- elif creatorOrcid -%}
                      <br>{{ macros.orcid(creatorOrcid) }}
                    {%- endif -%}
                    {%- if creatorAffiliationReply -%}
                      <br>{{ macros.ror(creatorAffiliationReply) }}
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            {%- else -%}
              <span class="empty-value">{% trans %}There is no creator specified yet{% endtrans %}</span>
          {%- endif -%}
        </dd>
      

      {% for version in dc.questionnaire.versions if version.uuid == ctx.questionnaire.versionUuid %}
      <dt>{% trans %}Version{% endtrans %}</dt>
      <dd>{{version.name}} ({{ version.created_at|datetime_format("%d %b %Y") }})</dd>
      {% endfor %}

      <dt>{% trans %}Generated on{% endtrans %}</dt>
      <dd>{{ dc.document.created_at|datetime_format("%d %b %Y") }}</dd>
    </dl>
    <p class="note">
      {% trans service_name=dc.config.service_name %}Data Management Plan created in {{ service_name }} &laquo;{% endtrans %}<a href="{{ dc.config.service_url }}" target="_blank">{{ dc.config.service_domain_name }}</a>&raquo;
    </p>
  </div>
</header>
