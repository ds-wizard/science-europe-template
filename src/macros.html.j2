{# Formatting macros #}
{#- An answer in Markdown: a single paragraph stays inline (it continues a sentence), more become
    blocks; headings in answers become bold paragraphs (not headings of the document) -#}
{%- macro md(text) -%}
  {%- set ns = namespace(html=(text|markdown)|trim) -%}
  {%- for level in range(1, 7) -%}
    {%- set ns.html = ns.html|replace('<h%d>'|format(level)|safe, '<p class="answer-heading"><strong>'|safe)|replace('</h%d>'|format(level)|safe, '</strong></p>'|safe) -%}
  {%- endfor -%}
  {%- if ns.html.startswith('<p>') and ns.html.endswith('</p>') and ns.html.count('<p') == 1 -%}
    {{ ns.html[3:-4]|safe }}
  {%- else -%}
    {{ ns.html|safe }}
  {%- endif -%}
{%- endmacro -%}
{%- macro formatEmail(email) -%}
  <span class="contact-email"><a href="mailto:{{ email }}">{{ email }}</a></span>
{%- endmacro -%}

{%- macro formatOrcid(reply) -%}
  {%- if reply and reply.value.value.type == "IntegrationType" -%}
    {%- if reply.value.value.raw -%}
      {%- set replyObject = reply.value.value.raw -%}
      <span class="contact-orcid">{% trans %}ORCID:{% endtrans %} <a href="https://orcid.org/{{ replyObject["orcid-id"] }}" target="_blank">{{ replyObject["orcid-id"] }}</a></span>
    {%- else -%}
      {# Extract ORCID number from the value string #}
      {%- set value = reply.value.value.value %}
      {%- set orcid = value.split('ORCID:')[-1].strip().split()[0]|replace("**", "")|markdown|replace("<p>", "")|replace("</p>", "") if 'ORCID:' in value else None %}
      {%- if orcid and orcid|length >= 15 -%}
        <span class="contact-orcid">{% trans orcid=orcid %}ORCID: {{ orcid }}{% endtrans %}</span>
      {%- else -%}
        <span class="contact-orcid">{% trans %}ORCID: Not found{% endtrans %}</span>
      {%- endif -%}
    {%- endif -%}
  {%- elif reply and reply.value.value.type == "PlainType" -%}
    <span class="contact-orcid">{% trans %}ORCID:{% endtrans %} <a href="https://orcid.org/{{ reply.value.value.value }}" target="_blank">{{ reply.value.value.value }}</a></span>
  {%- endif -%}
{%- endmacro -%}

{%- macro integrationFairSharing(reply) -%}
  {%- if reply and reply.value.value.type == "IntegrationType" -%}
    {%- if reply.value.value.raw -%}
      {%- set replyObject = reply.value.value.raw -%}
      {%- if replyObject.doi -%}
        <a href="https://doi.org/{{ replyObject.doi }}" target="_blank">{{ replyObject.name }}</a>
      {%- else -%}
        <a href="https://fairsharing.org/{{ replyObject.id }}" target="_blank">{{ replyObject.name }}</a>
      {%- endif -%}
    {%- else -%}
      {{ reply.value.value.value.rsplit(" ![]")[0]|replace("**", "")|markdown|replace("<p>", "")|replace("</p>", "") }}
    {%- endif -%}
  {%- elif reply and reply.value.value.type == "PlainType" -%}
    {{ reply.value.value.value }}
  {%- endif -%}
{%- endmacro -%}

