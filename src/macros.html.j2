{# Formatting macros #}
{#- An answer in Markdown: a single paragraph stays inline (it continues a sentence), more become
    blocks; headings in answers become bold paragraphs (not headings of the document) -#}
{%- macro md(text) -%}
  {%- set ns = namespace(html=(text|markdown)|trim) -%}
  {%- for level in range(1, 7) -%}
    {%- set ns.html = ns.html|replace('<h%d>'|format(level)|safe, '<p class="answer-heading"><strong>'|safe)|replace('</h%d>'|format(level)|safe, '</strong></p>'|safe) -%}
  {%- endfor -%}
  {%- if ns.html.startswith('<p>') and ns.html.endswith('</p>') and ns.html.count('<p') == 1 -%}
    {{ ns.html[3:-4]|safe }}
  {%- else -%}
    {{ ns.html|safe }}
  {%- endif -%}
{%- endmacro -%}
{%- macro formatEmail(email) -%}
  <span class="contact-email"><a href="mailto:{{ email }}">{{ email }}</a></span>
{%- endmacro -%}

{#- Integration replies of the data model (src/data/model.j2): an object with _value (the text of the
    reply) and, when an item of the integration was selected, _raw (its data) -#}

{%- macro orcid(o) -%}
  {%- if o._value is not none and '_raw' in o -%}
    {%- if o._raw -%}
      <span class="contact-orcid">{% trans %}ORCID:{% endtrans %} <a href="https://orcid.org/{{ o._raw["orcid-id"] }}" target="_blank">{{ o._raw["orcid-id"] }}</a></span>
    {%- else -%}
      {# Extract ORCID number from the value string #}
      {%- set value = o._value %}
      {%- set orcid = value.split('ORCID:')[-1].strip().split()[0]|replace("**", "")|markdown|replace("<p>", "")|replace("</p>", "") if 'ORCID:' in value else None %}
      {%- if orcid and orcid|length >= 15 -%}
        <span class="contact-orcid">{% trans orcid=orcid %}ORCID: {{ orcid }}{% endtrans %}</span>
      {%- else -%}
        <span class="contact-orcid">{% trans %}ORCID: Not found{% endtrans %}</span>
      {%- endif -%}
    {%- endif -%}
  {%- elif o._value is not none -%}
    <span class="contact-orcid">{% trans %}ORCID:{% endtrans %} <a href="https://orcid.org/{{ o._value }}" target="_blank">{{ o._value }}</a></span>
  {%- endif -%}
{%- endmacro -%}

{#- The text of an integration reply without a selected item: its first part, without bold -#}
{%- macro _integrationText(o) -%}
  {{ o._value.rsplit(" ![]")[0]|replace("**", "")|markdown|replace("<p>", "")|replace("</p>", "") }}
{%- endmacro -%}

{%- macro fairsharing(o) -%}
  {%- if o._value is not none and '_raw' in o -%}
    {%- if o._raw -%}
      {%- if o._raw.doi -%}
        <a href="https://doi.org/{{ o._raw.doi }}" target="_blank">{{ o._raw.name }}</a>
      {%- else -%}
        <a href="https://fairsharing.org/{{ o._raw.id }}" target="_blank">{{ o._raw.name }}</a>
      {%- endif -%}
    {%- else -%}
      {{ _integrationText(o) }}
    {%- endif -%}
  {%- elif o._value is not none -%}
    {{ o._value }}
  {%- endif -%}
{%- endmacro -%}

{%- macro crossref(o) -%}
  {%- if o._value is not none and '_raw' in o -%}
    {%- if o._raw -%}
      <a href="{{ o._raw.uri }}" target="_blank">{{ o._raw.name }}</a>
    {%- else -%}
      {{ _integrationText(o) }}
    {%- endif -%}
  {%- elif o._value is not none -%}
    {{ o._value }}
  {%- endif -%}
{%- endmacro -%}

{%- macro ror(o) -%}
  {%- if o._value is not none and '_raw' in o -%}
    {%- if o._raw -%}
      {%- set item = o._raw -%}
      {% for name in item.names -%}
        {% if "ror_display" in name.types -%}
          <a href="{{ item.id }}" target="_blank">{{ name.value }}</a>
        {%- endif %}
      {%- endfor %}
      {% for name in item.names -%}
        {% if "acronym" in name.types -%}
          ({{ name.value }})
        {%- endif %}
      {%- endfor %}
    {%- else -%}
      {{ _integrationText(o) }}
    {%- endif -%}
  {%- elif o._value is not none -%}
    {{ o._value }}
  {%- endif -%}
{%- endmacro -%}

{%- macro currency(o) -%}
  {%- if o._value is not none and '_raw' in o -%}
    {%- if o._raw -%}
      {{o._raw.code}} ({{o._raw.name}})
    {%- else -%}
      {{ _integrationText(o) }}
    {%- endif -%}
  {%- elif o._value is not none -%}
    {{ o._value }}
  {%- endif -%}
{%- endmacro -%}

{#- A short name of a FAIRsharing record (abbreviation, else name), or the text of the reply -#}
{%- macro fairsharingLabel(o) -%}
  {%- if o._raw and o._raw.abbreviation -%}
    {{ o._raw.abbreviation }}
  {%- elif o._raw and o._raw.name -%}
    {{ o._raw.name }}
  {%- elif o._value is not none and '_raw' in o -%}
    {{ _integrationText(o)|striptags }}
  {%- elif o._value is not none -%}
    {{ o._value }}
  {%- endif -%}
{%- endmacro -%}
